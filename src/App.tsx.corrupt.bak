import { getCurrentWindow } from "@tauri-apps/api/window";
import { open } from "@tauri-apps/plugin-dialog";
import { openUrl } from "@tauri-apps/plugin-opener";
import { api } from "./api";
import { confirmAction, withConfirm } from "./confirm";
import { ChangeList } from "./components/ChangeList";
import { ExtraPane, type Pane } from "./components/ExtraPane";
import {
  IdentityRemotePane,
  type IdentityRemoteDraft,
} from "./components/IdentityRemotePane";
import { LoadingScreen } from "./components/LoadingScreen";
import {
  commitsToRebaseRows,
  RebaseInteractiveModal,
  type RebaseTodoRow,
} from "./components/RebaseInteractiveModal";
import { Terminal } from "./components/Terminal";
import { WindowChrome } from "./components/WindowChrome";
import {
  clearRecent,
  loadRecent,
  pruneRecent,
  rememberRecent,
  removeRecent,
} from "./recent";
import { clearRepoCache, loadRepoCache, saveRepoCache } from "./repoCache";
import { formatGithubOwnerRepo, parseGithubOwnerRepo } from "./githubRepo";
import { applyGithubMirror, DEFAULT_GITHUB_HOSTS } from "./githubNetwork";
import {
  applyDocumentLocale,
  BUILTIN_LOCALES,
  t as i18n,
} from "./i18n";
import {
  applyPrefsToDocument,
  DEFAULT_PREFS,
  loadCloneUrl,
  loadOpenRepos,
  loadPrefs,
  resolveGithubMirrorPrefix,
  saveCloneUrl,
  saveOpenRepos,
  savePrefs,
  THEME_OPTIONS,
  type AppPrefs,
} from "./settingsStore";

type SettingsPage =
  | "auth"
  | "identity"
  | "appearance"
  | "behavior"
  | "language"
  | "network"
  | "reset"
  | "about";
import {
  failureLine,
  type SyncConflictKind,
} from "./statusMessage";
import type {
  AuthProvider,
  BranchInfo,
  CommitInfo,
  FileChange,
  GithubDeviceStart,
  GitInfo,
  Identity,
  LargeFileInfo,
  ProviderStatus,
  RemoteBranchInfo,
  RemoteInfo,
  RepoStatus,
  SshStatus,
  StashInfo,
  TagInfo,
  UpdateInfo,
} from "./types";

const LARGE_FILE_LIMIT_BYTES = 100 * 1024 * 1024;
import {
  UPDATE_REPO_NAME,
  UPDATE_REPO_OWNER,
  useAuthBootstrap,
} from "./hooks/useAuthBootstrap";
import { useRepoActions } from "./hooks/useRepoActions";
import "./App.css";

function folderName(path: string): string {
  const parts = path.replace(/[\\/]+$/, "").split(/[\\/]/);
  return parts[parts.length - 1] || path;
}

function statusFingerprint(s: RepoStatus): string {
  return JSON.stringify({
    branch: s.branch,
    ahead: s.ahead,
    behind: s.behind,
    operation: s.operation,
    changes: s.changes,
  });
}

function isEditableTarget(target: EventTarget | null): boolean {
  if (!(target instanceof HTMLElement)) return false;
  const tag = target.tagName;
  return (
    tag === "INPUT" ||
    tag === "TEXTAREA" ||
    tag === "SELECT" ||
    target.isContentEditable
  );
}

type FileFilter = "all" | "conflict" | "untracked";

type ProviderDraft = {
  token: string;
  clientId: string;
  clientSecret: string;
  showToken: boolean;
  showOauth: boolean;
};

type BootState = {
  path: string;
  progress: number;
  label: string;
  fromCache: boolean;
};

function sleep(ms: number) {
  return new Promise((resolve) => window.setTimeout(resolve, ms));
}


export default function App() {
  const [gitInfo, setGitInfo] = useState<GitInfo | null>(null);
  const [repoPath, setRepoPath] = useState<string | null>(null);
  const [openRepos, setOpenRepos] = useState<string[]>(() => loadOpenRepos());
  const [status, setStatus] = useState<RepoStatus | null>(null);
  const [branches, setBranches] = useState<BranchInfo[]>([]);
  const [remoteBranches, setRemoteBranches] = useState<RemoteBranchInfo[]>([]);
  const [recent, setRecent] = useState<string[]>(() => loadRecent());
  const [prefs, setPrefs] = useState<AppPrefs>(() => {
    const initial = loadPrefs();
    applyPrefsToDocument(initial);
    return initial;
  });
  const [message, setMessage] = useState("");
  const [error, setError] = useState<string | null>(null);
  const [notice, setNoticeState] = useState<string | null>(null);
  /** When true, notice does not auto-dismiss (e.g. push completed). */
  const [noticeSticky, setNoticeSticky] = useState(false);
  const setNotice = useCallback((text: string | null, sticky = false) => {
    setNoticeSticky(Boolean(text && sticky));
    setNoticeState(text);
  }, []);
  const [busy, setBusy] = useState(false);
  const busyRef = useRef(false);
  const [selected, setSelected] = useState<{ path: string; staged: boolean } | null>(
    null,
  );
  const [diff, setDiff] = useState("");
  const [diffLoading, setDiffLoading] = useState(false);
  const [newBranch, setNewBranch] = useState("");
  const [pane, setPane] = useState<Pane>("terminal");
  const [commits, setCommits] = useState<CommitInfo[]>([]);
  const [selectedHash, setSelectedHash] = useState<string | null>(null);
  const [commitPatch, setCommitPatch] = useState("");
  const [patchLoading, setPatchLoading] = useState(false);
  const [stashes, setStashes] = useState<StashInfo[]>([]);
  const [stashMessage, setStashMessage] = useState("");
  const [stashIncludeUntracked, setStashIncludeUntracked] = useState(true);
  const [tags, setTags] = useState<TagInfo[]>([]);
  const [tagName, setTagName] = useState("");
  const [identity, setIdentity] = useState<Identity>({ name: "", email: "" });
  const [identitySaved, setIdentitySaved] = useState(false);
  const [saveGlobally, setSaveGlobally] = useState(true);
  const [remotes, setRemotes] = useState<RemoteInfo[]>([]);
  const [remoteUrl, setRemoteUrl] = useState("");
  const [cloneUrl, setCloneUrl] = useState(() => loadCloneUrl());
  const [mergeTarget, setMergeTarget] = useState("");
  const [rebaseTarget, setRebaseTarget] = useState("");
  const [terminal, setTerminal] = useState("");
  const [showSettings, setShowSettings] = useState(false);
  const [settingsPage, setSettingsPage] = useState<SettingsPage>("auth");
  const [langDraftCode, setLangDraftCode] = useState("");
  const [langDraftLabel, setLangDraftLabel] = useState("");
  const [appVersion, setAppVersion] = useState(
    typeof __APP_VERSION__ === "string" ? __APP_VERSION__ : "鈥?,
  );
  const [showHelp, setShowHelp] = useState(false);
  const [updateInfo, setUpdateInfo] = useState<UpdateInfo | null>(null);
  const [updateBusy, setUpdateBusy] = useState(false);
  const [updateProgress, setUpdateProgress] = useState<{
    percent: number;
    label: string;
  } | null>(null);
  const [dismissedUpdateTag, setDismissedUpdateTag] = useState<string | null>(null);
  const [boot, setBoot] = useState<BootState | null>(null);
  const [entering, setEntering] = useState(false);
  const [syncingCache, setSyncingCache] = useState(false);
  const [syncDialog, setSyncDialog] = useState<SyncConflictKind | null>(null);
  /** 鎺ㄩ…佷富按钮模式：直接推送，或同步到另一平台 */
  const [pushMode, setPushMode] = useState<"direct" | "mirror">("direct");
  const [pushMenuOpen, setPushMenuOpen] = useState(false);
  const [pullMode, setPullMode] = useState<"merge" | "rebase">("merge");
  const [pullMenuOpen, setPullMenuOpen] = useState(false);
  const [tagMessage, setTagMessage] = useState("");
  const [stashPreview, setStashPreview] = useState<string | null>(null);
  const [fileHistoryPath, setFileHistoryPath] = useState<string | null>(null);
  const [fileHistoryCommits, setFileHistoryCommits] = useState<CommitInfo[] | null>(
    null,
  );
  const [compareLeft, setCompareLeft] = useState("");
  const [compareRight, setCompareRight] = useState("HEAD");
  const [compareResult, setCompareResult] = useState<string | null>(null);
  const [cloneDialog, setCloneDialog] = useState<{
    url: string;
    branch: string;
    depth: string;
  } | null>(null);
  const [upstreamTarget, setUpstreamTarget] = useState<{
    localBranch: string;
    remote: string;
    remoteBranch: string;
  } | null>(null);
  const [fetchMenuOpen, setFetchMenuOpen] = useState(false);
  const [pushRemote, setPushRemote] = useState<string | null>(null);
  const [blameText, setBlameText] = useState<string | null>(null);
  const [showReflog, setShowReflog] = useState(false);
  const [reflogEntries, setReflogEntries] = useState<
    import("./types").ReflogInfo[]
  >([]);
  const [conflictContent, setConflictContent] = useState<string | null>(null);
  const [conflictLoading, setConflictLoading] = useState(false);
  const [rebaseInteractive, setRebaseInteractive] = useState<{
    onto: string;
    rows: RebaseTodoRow[];
  } | null>(null);
  const [publishDialog, setPublishDialog] = useState<{
    path: string;
    name: string;
  } | null>(null);
  const [publishDraft, setPublishDraft] = useState({
    name: "",
    toGithub: true,
    toGitee: true,
    privateRepo: false,
  });
  const pendingPublishRef = useRef<string | null>(null);
  const [resetTarget, setResetTarget] = useState<CommitInfo | null>(null);
  const [renameTarget, setRenameTarget] = useState<{
    oldName: string;
    value: string;
  } | null>(null);
  const [checkoutTarget, setCheckoutTarget] = useState<{
    commit: CommitInfo;
    branchName: string;
  } | null>(null);
  const [largeCommit, setLargeCommit] = useState<{
    mode: "commit" | "amend";
    message: string;
    files: LargeFileInfo[];
    exclude: Record<string, boolean>;
  } | null>(null);
  const [authTab, setAuthTab] = useState<AuthProvider>("github");
  const [drafts, setDrafts] = useState<Record<AuthProvider, ProviderDraft>>({
    github: {
      token: "",
      clientId: "",
      clientSecret: "",
      showToken: false,
      showOauth: false,
    },
    gitee: {
      token: "",
      clientId: "",
      clientSecret: "",
      showToken: false,
      showOauth: false,
    },
  });
  const [authHint, setAuthHint] = useState(false);
  const [sessionWarnings, setSessionWarnings] = useState<string[]>([]);
  const [addingAccount, setAddingAccount] = useState(false);
  const { accounts, setAccounts, refreshAccounts, checkForUpdate } =
    useAuthBootstrap({
      appVersion,
      setGitInfo,
      setTerminal,
      setError,
      setNotice,
      setUpdateInfo,
      setUpdateBusy,
      setSessionWarnings,
      setDrafts,
      setAddingAccount,
    });
  const [deviceFlow, setDeviceFlow] = useState<GithubDeviceStart | null>(null);
  const [deviceStatus, setDeviceStatus] = useState("");
  const devicePollRef = useRef<number | null>(null);
  const [sshStatus, setSshStatus] = useState<SshStatus | null>(null);
  const [sshFeedback, setSshFeedback] = useState<{
    ok: boolean | null;
    text: string;
  } | null>(null);
  const authSectionRef = useRef<HTMLElement | null>(null);
  const [recentExists, setRecentExists] = useState<Record<string, boolean>>({});
  const [fileQuery, setFileQuery] = useState("");
  const [fileFilter, setFileFilter] = useState<FileFilter>("all");
  const [syncProgress, setSyncProgress] = useState<{
    label: string;
    percent: number;
    detail: string;
  } | null>(null);
  const syncProgressActive = useRef(false);
  const messageRef = useRef(message);
  messageRef.current = message;
  /** Live identity/remote drafts (no App re-render while typing). */
  const identityDraftRef = useRef<IdentityRemoteDraft | null>(null);
  const onIdentityDraftChange = useCallback((draft: IdentityRemoteDraft) => {
    identityDraftRef.current = draft;
  }, []);

  useEffect(() => {
    void getVersion()
      .then(setAppVersion)
      .catch(() => {
        if (typeof __APP_VERSION__ === "string") setAppVersion(__APP_VERSION__);
      });
  }, []);

  useEffect(() => {
    const unlisten = listen<{ percent: number; label: string }>(
      "update-progress",
      (event) => {
        setUpdateProgress({
          percent: Math.max(0, Math.min(100, event.payload.percent)),
          label: event.payload.label,
        });
      },
    );
    return () => {
      void unlisten.then((f) => f());
    };
  }, []);

  async function downloadAndInstallUpdate() {
    if (!updateInfo?.updateAvailable) return;
    const ok = await confirmAction(
      `将下杞?v${updateInfo.latestVersion} 瀹夎包并鍚姩瀹夎程序。\n瀹夎鏃惰先关闂潚鏋濄…傛槸否继缁紵`,
      { title: "瀹夎更新", confirmLabel: "下载并安瑁? },
    );
    if (!ok) return;
    setUpdateBusy(true);
    setUpdateProgress({ percent: 1, label: "鍑嗗下载鈥? });
    setError(null);
    setNotice(`正在下载 v${updateInfo.latestVersion}鈥);
    try {
      const path = await api.downloadAppUpdate(
        updateInfo.assetUrl,
        updateInfo.assetName,
      );
      setNotice("下载完成锛屾在打寮…瀹夎程序鈥?);
      await api.launchAppInstaller(path, true);
    } catch (e) {
      setNotice(null);
      setError(failureLine(e));
    } finally {
      setUpdateBusy(false);
      setUpdateProgress(null);
    }
  }

  useEffect(() => {
    let pending = "";
    let flushTimer: number | undefined;
    const flush = () => {
      flushTimer = undefined;
      if (!pending) return;
      const chunk = pending;
      pending = "";
      setTerminal((prev) => {
        const next = `${prev}${chunk}`;
        // Keep terminal from growing forever and slowing the UI.
        if (next.length <= 120_000) return next;
        return `# …终绔緭出过长，已截鏂棫鍐呭鈥n${next.slice(-80_000)}`;
      });
    };
    const unlisten = listen<{ kind: string; text: string }>("git-terminal", (event) => {
      const prefix =
        event.payload.kind === "cmd"
          ? ""
          : event.payload.kind === "err"
            ? ""
            : event.payload.kind === "info"
              ? "# "
              : "";
      pending += `${prefix}${event.payload.text}\n`;
      if (flushTimer === undefined) {
        flushTimer = window.setTimeout(flush, 80);
      }
    });
    const unlistenProgress = listen<{ percent: number; label: string }>(
      "git-progress",
      (event) => {
        if (!syncProgressActive.current) return;
        const percent = Math.max(0, Math.min(100, event.payload.percent));
        setSyncProgress((prev) =>
          prev
            ? {
                ...prev,
                percent: Math.max(prev.percent, percent),
                detail: event.payload.label || prev.detail,
              }
            : {
                label: "鍚屾涓?,
                percent,
                detail: event.payload.label,
              },
        );
      },
    );
    return () => {
      if (flushTimer !== undefined) window.clearTimeout(flushTimer);
      void unlisten.then((fn) => fn());
      void unlistenProgress.then((fn) => fn());
    };
  }, []);

  useEffect(() => {
    const ver =
      appVersion && appVersion !== "鈥?
        ? ` v${appVersion.replace(/^v/i, "")}`
        : "";
    const title = repoPath
      ? `${folderName(repoPath)} 鈥?青枝${ver}`
      : `青枝${ver}`;
    void getCurrentWindow().setTitle(title);
  }, [repoPath, appVersion]);

  useEffect(() => {
    if (!notice || noticeSticky) return;
    const current = notice;
    const timer = window.setTimeout(() => {
      setNoticeState((prev) => (prev === current ? null : prev));
      setNoticeSticky(false);
    }, 4500);
    return () => window.clearTimeout(timer);
  }, [notice, noticeSticky]);

  const repoPathRef = useRef<string | null>(null);
  repoPathRef.current = repoPath;

  const applyCore = useCallback((core: Awaited<ReturnType<typeof api.getRepoCore>>) => {
    setStatus(core.status);
    setBranches(core.branches);
    setRemoteBranches(core.remoteBranches);
    setIdentity(core.identity);
    setIdentitySaved(
      Boolean(core.identity.name.trim() && core.identity.email.includes("@")),
    );
    setRemotes(core.remotes);
    const origin =
      core.remotes.find((remote) => remote.name === "origin") ?? core.remotes[0];
    setRemoteUrl(origin?.url ?? "");
  }, []);

  const refresh = useCallback(
    async (path: string, opts?: { background?: boolean }) => {
      const background = opts?.background === true;
      if (!background) {
        busyRef.current = true;
        setBusy(true);
      }
      setError(null);
      try {
        const core = await api.getRepoCore(path);
        if (repoPathRef.current === path || !background) {
          applyCore(core);
        }
        if (!background) {
          busyRef.current = false;
          setBusy(false);
        }
        try {
          const extras = await api.getRepoExtras(path);
          if (repoPathRef.current === path) {
            setCommits(extras.commits);
            setStashes(extras.stashes);
            setTags(extras.tags);
            saveRepoCache(path, core, extras);
          }
        } catch (e) {
          if (repoPathRef.current === path) {
            saveRepoCache(path, core);
            if (!background) setError(failureLine(e));
          }
        }
      } catch (e) {
        if (!background) {
          setError(failureLine(e));
          busyRef.current = false;
          setBusy(false);
        }
        throw e;
      }
    },
    [applyCore],
  );

  const { runAction } = useRepoActions({
    repoPath,
    repoPathRef,
    busyRef,
    syncProgressActive,
    applyCore,
    refresh,
    setBusy,
    setError,
    setAuthHint,
    setNotice,
    setSyncProgress,
    setSyncDialog,
    setCommits,
    setStashes,
    setTags,
  });

  useEffect(() => {
    setFileHistoryPath(null);
    setFileHistoryCommits(null);
    setStashPreview(null);
    setCompareResult(null);
    setBlameText(null);
    setShowReflog(false);
    setReflogEntries([]);
    setConflictContent(null);
    setConflictLoading(false);
  }, [repoPath]);

  const wallpaperUrl = useMemo(() => {
    if (prefs.wallpaperKind === "none" || !prefs.wallpaperPath) return null;
    try {
      const src = convertFileSrc(prefs.wallpaperPath);
      // Bust webview cache after re-importing the same filename.
      const sep = src.includes("?") ? "&" : "?";
      return `${src}${sep}t=${encodeURIComponent(prefs.wallpaperPath)}`;
    } catch {
      return null;
    }
  }, [prefs.wallpaperKind, prefs.wallpaperPath]);

  const terminalWallpaperUrl = useMemo(() => {
    if (
      prefs.terminalWallpaperKind === "none" ||
      !prefs.terminalWallpaperPath
    ) {
      return null;
    }
    try {
      const src = convertFileSrc(prefs.terminalWallpaperPath);
      const sep = src.includes("?") ? "&" : "?";
      return `${src}${sep}t=${encodeURIComponent(prefs.terminalWallpaperPath)}`;
    } catch {
      return null;
    }
  }, [prefs.terminalWallpaperKind, prefs.terminalWallpaperPath]);

  function mediaKindFromPath(path: string): "image" | "video" {
    const lower = path.toLowerCase();
    return lower.endsWith(".mp4") ||
      lower.endsWith(".webm") ||
      lower.endsWith(".mov")
      ? "video"
      : "image";
  }

  const releaseTarget = useMemo(() => {
    const fromPrefs = parseGithubOwnerRepo(prefs.releaseRepoOverride);
    if (fromPrefs) {
      return { ...fromPrefs, source: "settings" as const };
    }
    const origin =
      remotes.find((remote) => remote.name === "origin") ?? remotes[0];
    const fromRemote = parseGithubOwnerRepo(origin?.url);
    if (fromRemote) {
      return { ...fromRemote, source: "remote" as const };
    }
    return { owner: "", repo: "", source: "none" as const };
  }, [prefs.releaseRepoOverride, remotes]);

  const refreshStatusQuiet = useCallback(async (path: string) => {
    if (busyRef.current) return;
    try {
      // Light poll skips untracked scan; backend skips if git lock is busy.
      const next = await api.getStatusLight(path);
      setStatus((prev) => {
        if (!prev) return next;
        // Keep previously known untracked entries so the list doesn't flicker away.
        const lightPaths = new Set(next.changes.map((c) => c.path));
        const keptUntracked = prev.changes.filter(
          (c) => c.untracked && !lightPaths.has(c.path),
        );
        const merged = {
          ...next,
          changes: keptUntracked.length
            ? [...next.changes, ...keptUntracked]
            : next.changes,
        };
        if (statusFingerprint(prev) === statusFingerprint(merged)) {
          return prev;
        }
        return merged;
      });
    } catch (e) {
      // GIT_BUSY or transient errors 鈥?keep previous UI, never block.
      const msg = String(e);
      if (!msg.includes("GIT_BUSY")) {
        /* ignore */
      }
    }
  }, []);

  useEffect(() => {
    if (!repoPath) return;
    const tick = () => {
      if (document.visibilityState === "visible" && !busyRef.current) {
        void refreshStatusQuiet(repoPath);
      }
    };
    const timer = window.setInterval(tick, 8000);
    window.addEventListener("focus", tick);
    document.addEventListener("visibilitychange", tick);
    return () => {
      window.clearInterval(timer);
      window.removeEventListener("focus", tick);
      document.removeEventListener("visibilitychange", tick);
    };
  }, [repoPath, refreshStatusQuiet]);

  useEffect(() => {
    if (recent.length === 0) {
      setRecentExists({});
      return;
    }
    let cancelled = false;
    void Promise.all(
      recent.map(async (path) => {
        try {
          return [path, await api.pathExists(path)] as const;
        } catch {
          return [path, false] as const;
        }
      }),
    ).then((pairs) => {
      if (!cancelled) setRecentExists(Object.fromEntries(pairs));
    });
    return () => {
      cancelled = true;
    };
  }, [recent]);

  const openFolder = useCallback(
    async (path: string) => {
      setError(null);
      setEntering(false);
      setBoot({
        path,
        progress: 6,
        label: "正在鍑嗗打开仓库鈥?,
        fromCache: false,
      });
      busyRef.current = true;
      setBusy(true);
      try {
        setBoot({
          path,
          progress: 14,
          label: "正在妫…查是否为 Git 仓库鈥?,
          fromCache: false,
        });
        const isRepo = await api.checkRepository(path);
        if (!isRepo) {
          const ok = await confirmAction(
            `銆?{path}」还不是 Git 仓库。\n鏄惁鍦ㄦ鐩綍鍒濆化？榛樿分支涓?main。`,
          );
          if (!ok) {
            setBoot(null);
            busyRef.current = false;
            setBusy(false);
            return;
          }
          setBoot({
            path,
            progress: 22,
            label: "正在鍒濆化仓搴撯…?,
            fromCache: false,
          });
          await api.initRepo(path);
          const baseName =
            path.split(/[/\\]/).filter(Boolean).pop()?.trim() || "repo";
          pendingPublishRef.current = baseName;
        }

        setSelected(null);
        setDiff("");
        setMessage("");
        setOpenRepos((prev) => {
          const next = prev.includes(path) ? prev : [...prev, path].slice(-12);
          saveOpenRepos(next);
          return next;
        });
        if (prefs.rememberRecent) {
          setRecent(rememberRecent(path));
        }

        const cached =
          prefs.useRepoCache ? loadRepoCache(path) : null;
        if (cached) {
          setBoot({
            path,
            progress: 62,
            label: "正在从缓存恢复界闈⑩…?,
            fromCache: true,
          });
          applyCore(cached.core);
          if (cached.extras) {
            setCommits(cached.extras.commits);
            setStashes(cached.extras.stashes);
            setTags(cached.extras.tags);
          }
          setRepoPath(path);
          setBoot({
            path,
            progress: 100,
            label: "即将进入鈥?,
            fromCache: true,
          });
          await sleep(320);
          setBoot(null);
          setEntering(true);
          busyRef.current = false;
          setBusy(false);
          setSyncingCache(true);
          try {
            await refresh(path, { background: true });
          } catch {
            /* keep cached view; quiet errors */
          } finally {
            setSyncingCache(false);
          }
          return;
        }

        setBoot({
          path,
          progress: 38,
          label: "正在读取工作区与分支鈥?,
          fromCache: false,
        });
        const core = await api.getRepoCore(path);
        applyCore(core);
        setBoot({
          path,
          progress: 68,
          label: "正在加载历史与标绛锯…?,
          fromCache: false,
        });
        let extras = undefined;
        try {
          extras = await api.getRepoExtras(path);
          setCommits(extras.commits);
          setStashes(extras.stashes);
          setTags(extras.tags);
          saveRepoCache(path, core, extras);
        } catch {
          saveRepoCache(path, core);
        }
        setBoot({
          path,
          progress: 92,
          label: "正在整理界面鈥?,
          fromCache: false,
        });
        setRepoPath(path);
        setBoot({
          path,
          progress: 100,
          label: "完成",
          fromCache: false,
        });
        await sleep(280);
        setBoot(null);
        setEntering(true);
        busyRef.current = false;
        setBusy(false);
        if (pendingPublishRef.current) {
          const name = pendingPublishRef.current;
          pendingPublishRef.current = null;
          setPublishDraft({
            name,
            toGithub: Boolean(accounts?.github.loggedIn),
            toGitee: Boolean(accounts?.gitee.loggedIn),
            privateRepo: false,
          });
          setPublishDialog({ path, name });
        }
      } catch (e) {
        pendingPublishRef.current = null;
        setBoot(null);
        setError(failureLine(e));
        busyRef.current = false;
        setBusy(false);
      }
    },
    [
      accounts?.github.loggedIn,
      accounts?.gitee.loggedIn,
      applyCore,
      prefs.rememberRecent,
      prefs.useRepoCache,
      refresh,
    ],
  );

  const closeRepoTab = useCallback(
    (path: string) => {
      const next = openRepos.filter((p) => p !== path);
      saveOpenRepos(next);
      setOpenRepos(next);
      if (repoPath !== path) return;
      const fallback = next[next.length - 1] ?? null;
      if (fallback) {
        void openFolder(fallback);
      } else {
        setRepoPath(null);
        setStatus(null);
      }
    },
    [openFolder, openRepos, repoPath],
  );

  const updatePrefs = useCallback((patch: Partial<AppPrefs>) => {
    setPrefs((prev) => {
      const next = { ...prev, ...patch };
      savePrefs(next);
      applyPrefsToDocument(next);
      applyDocumentLocale(next.locale);
      return next;
    });
  }, []);

  const pickFolder = useCallback(async () => {
    const selectedPath = await open({
      directory: true,
      multiple: false,
      title: "选择项目文件澶?,
    });
    if (typeof selectedPath === "string") {
      await openFolder(selectedPath);
    }
  }, [openFolder]);

  const cloneRepo = useCallback(async () => {
    const draftClone = identityDraftRef.current?.clone?.trim() ?? "";
    const url = draftClone || cloneUrl.trim() || loadCloneUrl().trim();
    if (!url) {
      setError("请先鍦ㄨ缃噷濉啓克隆地址");
      openSettings("identity");
      return;
    }
    setCloneDialog({ url, branch: "", depth: "" });
  }, [cloneUrl, openSettings]);

  const confirmClone = useCallback(async () => {
    if (!cloneDialog) return;
    const url = cloneDialog.url.trim();
    if (!url) {
      setError("请填写克隆地鍧…");
      return;
    }
    saveCloneUrl(url);
    setCloneUrl(url);
    const selectedPath = await open({
      directory: true,
      multiple: false,
      title: "选择空文件夹作为克隆鐩爣",
    });
    if (typeof selectedPath !== "string") return;
    const branch = cloneDialog.branch.trim() || null;
    const depthRaw = Number(cloneDialog.depth.trim());
    const depth =
      Number.isFinite(depthRaw) && depthRaw > 0 ? Math.floor(depthRaw) : null;
    setCloneDialog(null);
    setBusy(true);
    setError(null);
    setNotice("正在克隆鈥?);
    const mirrorPrefix = resolveGithubMirrorPrefix(prefs);
    const cloneUrlEffective = applyGithubMirror(url, mirrorPrefix);
    if (cloneUrlEffective !== url) {
      setNotice(`正在经镜像克闅嗏…n${cloneUrlEffective}`);
    }
    try {
      const dest = await api.cloneRepo(cloneUrlEffective, selectedPath, {
        branch,
        depth,
      });
      setNotice("克隆完成");
      setShowSettings(false);
      await openFolder(dest);
    } catch (e) {
      setNotice(null);
      setError(failureLine(e));
      setBusy(false);
    }
  }, [cloneDialog, openFolder, prefs]);

  async function runMirrorPush() {
    if (!repoPath || !mirrorTarget) return;
    const useActions =
      prefs.mirrorSyncMethod === "actions" &&
      mirrorTarget === "gitee" &&
      primaryHost === "github";
    if (useActions) {
      void runAction(async () => {
        const status = await api.getActionsMirrorStatus(repoPath);
        if (!status.workflowExists) {
          throw new Error(
            "尚未瀹夎 Actions 工作娴併…傝鍒拌缃?鈫?行为，点「安瑁?Actions 镜像銆嶃…?,
          );
        }
        const text = await api.push(repoPath, false, null);
        return `${text}\n鈥斺…擻n已推送到 GitHub；Gitee 将由 Actions 鑷姩鍚屾（需已配缃?Secrets锛夈…俙;
      }, "正在鎺ㄩ…侊紙Actions 镜像锛夆…?);
      return;
    }
    void runAction(
      () => api.push(repoPath, false, mirrorTarget),
      mirrorTarget === "gitee"
        ? "正在鍚屾鎺ㄩ…?Gitee鈥?
        : "正在鍚屾鎺ㄩ…?GitHub鈥?,
    );
  }

  function saveIdentityAndRemote(draft: IdentityRemoteDraft) {
    const name = draft.name.trim();
    const email = draft.email.trim();
    const remote = draft.remote.trim();
    const clone = draft.clone.trim();

    saveCloneUrl(clone);
    setCloneUrl(clone);

    if (!repoPath) {
      setNotice(clone ? "已保存克隆地鍧…" : null);
      return;
    }

    const wantIdentity = Boolean(name && email.includes("@"));
    const wantRemote = Boolean(remote);
    if (!wantIdentity && !wantRemote) {
      setNotice(clone ? "已保存克隆地鍧…" : null);
      return;
    }

    void runAction(async () => {
      if (wantIdentity) {
        await api.setIdentity(repoPath, name, email, draft.saveGlobally);
        setIdentity({ name, email });
        setIdentitySaved(true);
      }
      if (wantRemote) {
        await api.saveRemote(repoPath, "origin", remote);
        setRemoteUrl(remote);
      }
    }, "正在保存韬唤与远绋嬧…?);
  }

  function applyAccount(status: ProviderStatus) {
    const key = (status.provider === "gitee" ? "gitee" : "github") as AuthProvider;
    setAccounts((prev) =>
      prev
        ? { ...prev, [key]: status }
        : {
            github: key === "github" ? status : emptyProvider("github"),
            gitee: key === "gitee" ? status : emptyProvider("gitee"),
          },
    );
    setDrafts((prev) => ({
      ...prev,
      [key]: { ...prev[key], token: "" },
    }));
  }

  function emptyProvider(provider: AuthProvider): ProviderStatus {
    return {
      provider,
      loggedIn: false,
      login: "",
      name: "",
      avatarUrl: "",
      clientId: "",
      hasClientId: false,
      hasClientSecret: false,
      sessionExpired: false,
      accounts: [],
      oauthReady: false,
      usingBuiltinOauth: false,
    };
  }

  const stopDevicePoll = useCallback(() => {
    if (devicePollRef.current !== null) {
      window.clearTimeout(devicePollRef.current);
      devicePollRef.current = null;
    }
  }, []);

  const refreshSsh = useCallback(async () => {
    try {
      setSshStatus(await api.authSshStatus());
    } catch {
      /* SSH optional */
    }
  }, []);

  useEffect(() => {
    if (!showSettings) return;
    void refreshAccounts();
    if (settingsPage === "auth") void refreshSsh();
  }, [showSettings, settingsPage, refreshAccounts, refreshSsh]);

  useEffect(() => () => stopDevicePoll(), [stopDevicePoll]);

  function openSettings(page: SettingsPage = "auth") {
    setSettingsPage(page);
    setShowSettings(true);
  }

  function openSettingsAuth(provider?: AuthProvider) {
    if (provider) setAuthTab(provider);
    openSettings("auth");
  }

  function updateDraft(
    provider: AuthProvider,
    patch: Partial<ProviderDraft>,
  ) {
    setDrafts((prev) => ({
      ...prev,
      [provider]: { ...prev[provider], ...patch },
    }));
  }

  async function loginWithGitManager(provider: AuthProvider) {
    setBusy(true);
    setError(null);
    setAuthHint(false);
    setNotice(
      provider === "github"
        ? "正在打开 Git 鍑嵁管理鍣ㄢ…?
        : "正在读取 Gitee 鍑嵁（可能弹出输鍏ユ锛夆…?,
    );
    try {
      const status = await api.authManagerLogin(provider);
      applyAccount(status);
      setAddingAccount(false);
      setSessionWarnings((prev) =>
        prev.filter((p) => p !== (provider === "github" ? "GitHub" : "Gitee")),
      );
      setNotice(`宸查…氳繃 Git 登录锛?{status.login}`);
    } catch (e) {
      setNotice(null);
      setError(failureLine(e));
      setAuthHint(true);
    } finally {
      setBusy(false);
    }
  }

  async function loginWithBrowser(provider: AuthProvider) {
    const draft = drafts[provider];
    const clientId = draft.clientId.trim();
    const clientSecret = draft.clientSecret.trim();
    const ready =
      accounts?.[provider]?.oauthReady &&
      accounts[provider].hasClientSecret;
    if ((!clientId || !clientSecret) && !ready) {
      setError(
        "娴忚器登录需瑕?Client ID 鍜?Client Secret（可在下方配缃竴次并保存锛夈…傝备码登录鍙渶 Client ID銆?,
      );
      updateDraft(provider, { showOauth: true });
      return;
    }
    setBusy(true);
    setError(null);
    setAuthHint(false);
    setNotice("正在打开娴忚鍣紝请完成授鏉冣…?);
    try {
      if (clientId && clientSecret) {
        await api.authSaveOauthConfig(provider, clientId, clientSecret);
      }
      const begin = await api.authStartBrowser(provider);
      await openUrl(begin.authUrl);
      setNotice("请在娴忚器完成授权，返回鏈獥口等寰呪…?);
      const status = await api.authFinishBrowser(provider);
      applyAccount(status);
      setAddingAccount(false);
      setSessionWarnings((prev) =>
        prev.filter((p) => p !== (provider === "github" ? "GitHub" : "Gitee")),
      );
      setNotice(`宸查…氳繃娴忚器登录：${status.login}`);
    } catch (e) {
      setNotice(null);
      setError(failureLine(e));
      setAuthHint(true);
    } finally {
      setBusy(false);
    }
  }

  async function loginWithDevice() {
    stopDevicePoll();
    setBusy(true);
    setError(null);
    setAuthHint(false);
    setDeviceStatus("");
    setNotice("正在鐢宠 GitHub 璁惧鐮佲…?);
    try {
      const draft = drafts.github;
      if (draft.clientId.trim()) {
        await api.authSaveOauthConfig(
          "github",
          draft.clientId.trim(),
          draft.clientSecret.trim(),
        );
      }
      const start = await api.authStartDevice();
      setDeviceFlow(start);
      setNotice(`请在娴忚器打寮… ${start.verificationUri}，输入代鐮?${start.userCode}`);
      setDeviceStatus("等待授权鈥?);
      setBusy(false);
      const poll = async (intervalSec: number) => {
        devicePollRef.current = window.setTimeout(async () => {
          try {
            const result = await api.authPollDevice(start.deviceCode);
            if (result.status === "success" && result.account) {
              stopDevicePoll();
              setDeviceFlow(null);
              setDeviceStatus("");
              applyAccount(result.account);
              setAddingAccount(false);
              setSessionWarnings((prev) => prev.filter((p) => p !== "GitHub"));
              setNotice(`宸查…氳繃璁惧码登录：${result.account.login}`);
              return;
            }
            const nextInterval =
              result.status === "slow_down"
                ? intervalSec + 5
                : Math.max(intervalSec, start.interval);
            setDeviceStatus(result.message || "等待授权鈥?);
            void poll(nextInterval);
          } catch (e) {
            stopDevicePoll();
            setDeviceFlow(null);
            setDeviceStatus("");
            setError(failureLine(e));
            setAuthHint(true);
          }
        }, intervalSec * 1000);
      };
      void poll(start.interval);
    } catch (e) {
      setNotice(null);
      setDeviceFlow(null);
      setError(failureLine(e));
      if (/Client ID/i.test(String(e))) {
        updateDraft("github", { showOauth: true });
      }
      setAuthHint(true);
      setBusy(false);
    }
  }

  async function switchAccount(provider: AuthProvider, accountId: string) {
    setBusy(true);
    setError(null);
    try {
      const status = await api.authSwitchAccount(provider, accountId);
      applyAccount(status);
      setAddingAccount(false);
      setNotice(`已切换到 ${status.login}`);
    } catch (e) {
      setError(failureLine(e));
    } finally {
      setBusy(false);
    }
  }

  async function loginWithToken(provider: AuthProvider, tokenOverride?: string) {
    const token = (tokenOverride ?? drafts[provider].token).trim();
    if (!token) return;
    setBusy(true);
    setError(null);
    setAuthHint(false);
    try {
      const status = await api.authLoginToken(provider, token);
      applyAccount(status);
      updateDraft(provider, { token: "" });
      setAddingAccount(false);
      setSessionWarnings((prev) =>
        prev.filter((p) => p !== (provider === "github" ? "GitHub" : "Gitee")),
      );
      setNotice(`已登褰?${status.login}`);
    } catch (e) {
      setError(failureLine(e));
      setAuthHint(true);
    } finally {
      setBusy(false);
    }
  }

  async function logoutProvider(provider: AuthProvider) {
    const label = provider === "github" ? "GitHub" : "Gitee";
    const ok = await confirmAction(
      `閫…鍑?${label}${accounts?.[provider]?.login ? `锛?{accounts[provider].login}）` : ""}？\n将清除本工具保存的全閮?${label} 登录信息，并尽量删除系统 Git / 鍑嵁管理器中鐨勫应条鐩…俙,
      { title: "閫…出登褰?, danger: true, confirmLabel: "閫…鍑? },
    );
    if (!ok) return;
    setBusy(true);
    setError(null);
    setNotice(`正在閫…鍑?${label}鈥);
    try {
      const status = await api.authLogout(provider);
      applyAccount(status);
      setAccounts((prev) =>
        prev
          ? {
              ...prev,
              [provider]: status.loggedIn ? status : emptyProvider(provider),
            }
          : prev,
      );
      setAddingAccount(false);
      setSessionWarnings((prev) => prev.filter((p) => p !== label));
      setNotice(status.loggedIn ? `已切鎹紝当前锛?{status.login}` : `宸查……鍑?${label}`);
    } catch (e) {
      setNotice(null);
      setError(failureLine(e));
    } finally {
      setBusy(false);
    }
  }

  useEffect(() => {
    setBlameText(null);
    setConflictContent(null);
    if (!repoPath || !selected) {
      setDiff("");
      return;
    }
    let cancelled = false;
    setDiffLoading(true);
    api
      .getDiff(repoPath, selected.path, selected.staged)
      .then((text) => {
        if (!cancelled) setDiff(text);
      })
      .catch((e) => {
        if (!cancelled) {
          setDiff("");
          setError(failureLine(e));
        }
      })
      .finally(() => {
        if (!cancelled) setDiffLoading(false);
      });
    return () => {
      cancelled = true;
    };
  }, [repoPath, selected]);

  useEffect(() => {
    if (!repoPath || !selectedHash || pane !== "history") {
      return;
    }
    let cancelled = false;
    setPatchLoading(true);
    api
      .getCommitPatch(repoPath, selectedHash)
      .then((text) => {
        if (!cancelled) setCommitPatch(text);
      })
      .catch((e) => {
        if (!cancelled) {
          setCommitPatch("");
          setError(failureLine(e));
        }
      })
      .finally(() => {
        if (!cancelled) setPatchLoading(false);
      });
    return () => {
      cancelled = true;
    };
  }, [repoPath, selectedHash, pane]);

  const staged = useMemo(
    () => status?.changes.filter((c) => c.staged && !c.untracked) ?? [],
    [status],
  );
  const unstaged = useMemo(
    () =>
      status?.changes.filter((c) => c.unstaged || c.untracked || c.conflicted) ??
      [],
    [status],
  );
  const conflictFiles = useMemo(
    () => status?.changes.filter((c) => c.conflicted) ?? [],
    [status],
  );
  const filterChanges = useCallback(
    (files: FileChange[]) => {
      let list = files;
      if (fileFilter === "conflict") {
        list = list.filter((f) => f.conflicted);
      } else if (fileFilter === "untracked") {
        list = list.filter((f) => f.untracked);
      }
      const q = fileQuery.trim().toLowerCase();
      if (q) {
        list = list.filter((f) => f.path.toLowerCase().includes(q));
      }
      return list;
    },
    [fileFilter, fileQuery],
  );
  const filteredUnstaged = useMemo(
    () => filterChanges(unstaged),
    [filterChanges, unstaged],
  );
  const filteredStaged = useMemo(
    () => filterChanges(staged),
    [filterChanges, staged],
  );
  const hasChanges = staged.length + unstaged.length > 0;
  const ahead = status?.ahead ?? 0;
  const behind = status?.behind ?? 0;
  const primaryHost = useMemo((): "github" | "gitee" | null => {
    const origin =
      remotes.find((r) => r.name === "origin") ?? remotes[0] ?? null;
    if (!origin) return null;
    const url = origin.url.toLowerCase();
    if (url.includes("github.com")) return "github";
    if (url.includes("gitee.com")) return "gitee";
    return null;
  }, [remotes]);
  const mirrorTarget =
    primaryHost === "github"
      ? ("gitee" as const)
      : primaryHost === "gitee"
        ? ("github" as const)
        : null;
  const mirrorMenuLabel =
    mirrorTarget === "gitee"
      ? "鎺ㄩ…佸埌 Gitee"
      : mirrorTarget === "github"
        ? "鎺ㄩ…佸埌 GitHub"
        : null;
  const mirrorButtonLabel =
    mirrorTarget === "gitee"
      ? "鍚屾鎺ㄩ…侊紙Gitee锛?
      : mirrorTarget === "github"
        ? "鍚屾鎺ㄩ…侊紙GitHub锛?
        : null;
  const defaultRemoteName =
    remotes.find((r) => r.name === "origin")?.name ?? remotes[0]?.name ?? null;
  const activePushRemote = pushRemote ?? defaultRemoteName;

  useEffect(() => {
    if (!mirrorTarget && pushMode === "mirror") setPushMode("direct");
  }, [mirrorTarget, pushMode]);

  useEffect(() => {
    if (!status) return;
    if (
      status.operation !== "merge" &&
      status.operation !== "cherry-pick" &&
      status.operation !== "rebase" &&
      status.operation !== "revert"
    ) {
      return;
    }
    if (conflictFiles.length === 0) return;
    setPane("diff");
    setSelected((cur) => {
      if (cur && conflictFiles.some((f) => f.path === cur.path)) return cur;
      return { path: conflictFiles[0].path, staged: false };
    });
  }, [status?.operation, conflictFiles]);

  useEffect(() => {
    if (!pushMenuOpen && !pullMenuOpen && !fetchMenuOpen) return;
    const onPointer = (e: MouseEvent) => {
      const target = e.target as HTMLElement | null;
      if (target?.closest(".push-split")) return;
      if (target?.closest(".pull-split")) return;
      if (target?.closest(".fetch-split")) return;
      setPushMenuOpen(false);
      setPullMenuOpen(false);
      setFetchMenuOpen(false);
    };
    window.addEventListener("mousedown", onPointer);
    return () => window.removeEventListener("mousedown", onPointer);
  }, [pushMenuOpen, pullMenuOpen, fetchMenuOpen]);

  useEffect(() => {
    if (!pushRemote) return;
    if (!remotes.some((r) => r.name === pushRemote)) {
      setPushRemote(null);
    }
  }, [remotes, pushRemote]);

  useEffect(() => {
    if (!repoPath) return;
    const onKey = (e: KeyboardEvent) => {
      const mod = e.ctrlKey || e.metaKey;
      const typing = isEditableTarget(e.target);

      if (e.key === "F5") {
        e.preventDefault();
        void refresh(repoPath);
        return;
      }

      if (!mod) return;

      if (e.key === "Enter" && !e.shiftKey) {
        const msg = messageRef.current.trim();
        if (
          busyRef.current ||
          !msg ||
          staged.length === 0 ||
          !identitySaved
        ) {
          return;
        }
        e.preventDefault();
        void requestCommit("commit");
        return;
      }

      if (typing) return;

      if ((e.key === "r" || e.key === "R") && !e.shiftKey) {
        e.preventDefault();
        void refresh(repoPath);
      } else if ((e.key === "s" || e.key === "S") && !e.shiftKey) {
        if (unstaged.length === 0 || busyRef.current) return;
        e.preventDefault();
        void runAction(
          () => api.stageFiles(
            repoPath,
            unstaged.map((f) => f.path),
          ),
          "正在暂存鈥?,
        );
      } else if ((e.key === "l" || e.key === "L") && e.shiftKey) {
        e.preventDefault();
        void runAction(
          () => api.pull(repoPath, false, pullMode === "rebase"),
          pullMode === "rebase" ? "正在变基拉取鈥? : "正在拉取鈥?,
        );
      } else if ((e.key === "p" || e.key === "P") && e.shiftKey) {
        e.preventDefault();
        if (pushMode === "mirror" && mirrorTarget) {
          void runMirrorPush();
        } else {
          void runAction(
            () => api.push(repoPath, false, null, activePushRemote),
            activePushRemote && activePushRemote !== defaultRemoteName
              ? `正在鎺ㄩ…佸埌 ${activePushRemote}鈥
              : "正在鎺ㄩ…佲…?,
          );
        }
      }
    };
    window.addEventListener("keydown", onKey);
    return () => window.removeEventListener("keydown", onKey);
  }, [
    repoPath,
    refresh,
    staged.length,
    unstaged,
    identitySaved,
    pushMode,
    pullMode,
    mirrorTarget,
    prefs.mirrorSyncMethod,
    primaryHost,
    activePushRemote,
    defaultRemoteName,
  ]);

  async function loadFileHistory(file: string) {
    if (!repoPath) return;
    await runAction(async () => {
      const list = await api.getFileCommits(repoPath, file, 80);
      setFileHistoryPath(file);
      setFileHistoryCommits(list);
      setPane("history");
      setSelectedHash(list[0]?.hash ?? null);
      return list.length > 0
        ? `已加杞姐…?{file}」的 ${list.length} 条历史`
        : `銆?{file}」没有提交历史`;
    }, "正在加载文件历史鈥?);
  }

  async function requestCommit(mode: "commit" | "amend") {
    if (!repoPath || busyRef.current) return;
    if (!identitySaved) {
      openSettings("identity");
      return;
    }
    const msg = messageRef.current.trim();
    if (mode === "commit") {
      if (!msg || staged.length === 0) return;
    }

    setError(null);
    setNotice("正在妫…查大文件鈥?);
    try {
      const files = await api.listStagedLargeFiles(
        repoPath,
        LARGE_FILE_LIMIT_BYTES,
      );
      setNotice(null);
      if (files.length > 0) {
        const exclude: Record<string, boolean> = {};
        for (const f of files) exclude[f.path] = true;
        setLargeCommit({ mode, message: msg, files, exclude });
        return;
      }
    } catch (e) {
      setNotice(null);
      setError(failureLine(e));
      return;
    }

    void runAction(
      async () => {
        if (mode === "amend") {
          await api.amendCommit(repoPath, messageRef.current);
        } else {
          await api.createCommit(repoPath, msg);
        }
        setMessage("");
        setSelected(null);
      },
      mode === "amend" ? "正在淇敼涓婃提交鈥? : "正在提交鈥?,
    );
  }

  async function confirmLargeCommit() {
    if (!largeCommit || !repoPath) return;
    const { mode, message: msg, files, exclude } = largeCommit;
    const toExclude = files.filter((f) => exclude[f.path]).map((f) => f.path);
    setLargeCommit(null);

    void runAction(
      async () => {
        if (toExclude.length > 0) {
          await api.unstageFiles(repoPath, toExclude);
        }
        if (mode === "commit") {
          const core = await api.getRepoCore(repoPath);
          const left = core.status.changes.filter(
            (c) => c.staged && !c.untracked,
          );
          if (left.length === 0) {
            throw new Error(
              "排除大文件后没有鍙彁交的改动浜嗐…傝暂存其他文件，或取消排除部分大文浠躲…?,
            );
          }
        }
        if (mode === "amend") {
          await api.amendCommit(repoPath, msg);
        } else {
          await api.createCommit(repoPath, msg);
        }
        setMessage("");
        setSelected(null);
      },
      mode === "amend" ? "正在淇敼涓婃提交鈥? : "正在提交鈥?,
    );
  }

  function renderRebaseInteractiveDialog() {
    if (!rebaseInteractive) return null;
    const { onto, rows } = rebaseInteractive;
    return (
      <RebaseInteractiveModal
        onto={onto}
        rows={rows}
        busy={busy}
        onChange={(next) =>
          setRebaseInteractive((prev) =>
            prev ? { ...prev, rows: next } : prev,
          )
        }
        onCancel={() => setRebaseInteractive(null)}
        onConfirm={() => {
          withConfirm(
            `寮…始交互变基到銆?{onto}」？\n历史鍙兘琚敼写；若已鎺ㄩ…侊紝之后鍙兘闇…要强制推閫併…俙,
            () => {
              if (!repoPath) return;
              const path = repoPath;
              void runAction(async () => {
                const text = await api.branchRebaseInteractive(
                  path,
                  onto,
                  rows.map((r) => ({
                    action: r.action,
                    hash: r.hash,
                    subject: r.subject,
                  })),
                );
                setRebaseInteractive(null);
                return text || "交互变基完成";
              }, "正在交互变基鈥?);
            },
          );
        }}
      />
    );
  }

  function renderLargeCommitDialog() {
    if (!largeCommit) return null;
    const { files, exclude, mode } = largeCommit;
    const excludeCount = files.filter((f) => exclude[f.path]).length;
    const keepCount = files.length - excludeCount;
    return (
      <div className="modal-mask" onClick={() => setLargeCommit(null)}>
        <div
          className="modal sync-modal"
          onClick={(event) => event.stopPropagation()}
          role="dialog"
          aria-modal="true"
          aria-label="大文浠舵娴?
        >
          <h3>发现超过 100MB 的文浠?/h3>
          <p className="muted">
            GitHub 等平鍙伴…氬父拒绝单个超过 100MB 的文浠躲…傞粯认会排除它们；取消勾选表示仍要提浜よ文件銆?          </p>
          <ul className="large-file-list">
            {files.map((f) => (
              <li key={f.path}>
                <label className="large-file-item">
                  <input
                    type="checkbox"
                    checked={!!exclude[f.path]}
                    onChange={(e) =>
                      setLargeCommit((prev) =>
                        prev
                          ? {
                              ...prev,
                              exclude: {
                                ...prev.exclude,
                                [f.path]: e.target.checked,
                              },
                            }
                          : prev,
                      )
                    }
                  />
                  <span className="large-file-meta">
                    <strong title={f.path}>{f.path}</strong>
                    <span className="muted small">{f.sizeLabel}</span>
                  </span>
                  <span className="large-file-tag">
                    {exclude[f.path] ? "排除" : "仍提浜?}
                  </span>
                </label>
              </li>
            ))}
          </ul>
          <p className="muted small">
            将排闄?{excludeCount} 涓紝保留提交 {keepCount} 涓ぇ文件
            {mode === "amend" ? "（修改上次提交）" : ""}銆?          </p>
          <div className="modal-actions">
            <button type="button" onClick={() => setLargeCommit(null)}>
              取消
            </button>
            <button
              type="button"
              className="primary"
              onClick={() => void confirmLargeCommit()}
            >
              {excludeCount === files.length
                ? "排除后继缁?
                : keepCount > 0
                  ? "鎸夐…夋嫨继续"
                  : "继续提交"}
            </button>
          </div>
        </div>
      </div>
    );
  }

  function renderUpstreamDialog() {
    if (!upstreamTarget || !repoPath) return null;
    const remoteBranchesForRemote = remoteBranches
      .filter((rb) => rb.remote === upstreamTarget.remote)
      .map((rb) => rb.branch);
    const branchOptions = Array.from(
      new Set([
        upstreamTarget.remoteBranch,
        upstreamTarget.localBranch,
        ...remoteBranchesForRemote,
      ].filter(Boolean)),
    );
    const submit = () => {
      const remote = upstreamTarget.remote.trim();
      const branch = upstreamTarget.remoteBranch.trim();
      if (!remote || !branch) return;
      const local = upstreamTarget.localBranch;
      setUpstreamTarget(null);
      void runAction(
        () => api.branchSetUpstream(repoPath, remote, branch, local),
        "正在设置上游鈥?,
      );
    };
    return (
      <div className="modal-mask" onClick={() => setUpstreamTarget(null)}>
        <div
          className="modal sync-modal"
          onClick={(event) => event.stopPropagation()}
          role="dialog"
          aria-modal="true"
          aria-labelledby="upstream-dialog-title"
        >
          <h3 id="upstream-dialog-title">设置上游</h3>
          <p className="muted small">
            鏈湴分支「{upstreamTarget.localBranch}」跟韪殑远程分支锛?          </p>
          <label className="settings-field">
            <span>远程</span>
            <select
              value={upstreamTarget.remote}
              onChange={(e) => {
                const remote = e.target.value;
                const preferred =
                  remoteBranches.find(
                    (rb) =>
                      rb.remote === remote &&
                      rb.branch === upstreamTarget.localBranch,
                  )?.branch ??
                  remoteBranches.find((rb) => rb.remote === remote)?.branch ??
                  upstreamTarget.localBranch;
                setUpstreamTarget((cur) =>
                  cur
                    ? { ...cur, remote, remoteBranch: preferred }
                    : cur,
                );
              }}
              disabled={busy || remotes.length === 0}
            >
              {remotes.map((r) => (
                <option key={r.name} value={r.name}>
                  {r.name}
                </option>
              ))}
            </select>
          </label>
          <label className="settings-field">
            <span>远程分支</span>
            <input
              list="upstream-branch-options"
              value={upstreamTarget.remoteBranch}
              onChange={(e) =>
                setUpstreamTarget((cur) =>
                  cur ? { ...cur, remoteBranch: e.target.value } : cur,
                )
              }
              placeholder="濡?main"
              disabled={busy}
              onKeyDown={(e) => {
                if (e.key === "Enter" && !e.nativeEvent.isComposing) {
                  e.preventDefault();
                  submit();
                }
              }}
            />
            <datalist id="upstream-branch-options">
              {branchOptions.map((b) => (
                <option key={b} value={b} />
              ))}
            </datalist>
          </label>
          <div className="modal-actions">
            <button type="button" onClick={() => setUpstreamTarget(null)}>
              取消
            </button>
            <button
              type="button"
              className="primary"
              disabled={
                busy ||
                !upstreamTarget.remote.trim() ||
                !upstreamTarget.remoteBranch.trim()
              }
              onClick={submit}
            >
              纭畾
            </button>
          </div>
        </div>
      </div>
    );
  }

  function renderCloneDialog() {
    if (!cloneDialog) return null;
    return (
      <div className="modal-mask" onClick={() => setCloneDialog(null)}>
        <div
          className="modal sync-modal"
          onClick={(event) => event.stopPropagation()}
          role="dialog"
          aria-modal="true"
          aria-labelledby="clone-dialog-title"
        >
          <h3 id="clone-dialog-title">克隆仓库</h3>
          <label className="settings-field">
            <span>地址</span>
            <input
              value={cloneDialog.url}
              onChange={(e) =>
                setCloneDialog((cur) =>
                  cur ? { ...cur, url: e.target.value } : cur,
                )
              }
              placeholder="https://github.com/用户/仓库.git"
              autoFocus
            />
          </label>
          <label className="settings-field">
            <span>分支（可选）</span>
            <input
              value={cloneDialog.branch}
              onChange={(e) =>
                setCloneDialog((cur) =>
                  cur ? { ...cur, branch: e.target.value } : cur,
                )
              }
              placeholder="榛樿分支鍙暀绌?
            />
          </label>
          <label className="settings-field">
            <span>浅克隆深度（鍙…夛級</span>
            <input
              value={cloneDialog.depth}
              onChange={(e) =>
                setCloneDialog((cur) =>
                  cur ? { ...cur, depth: e.target.value } : cur,
                )
              }
              placeholder="渚嬪 1；留空为完整历史"
              inputMode="numeric"
            />
          </label>
          <div className="modal-actions">
            <button type="button" onClick={() => setCloneDialog(null)}>
              取消
            </button>
            <button
              type="button"
              className="primary"
              disabled={!cloneDialog.url.trim()}
              onClick={() => void confirmClone()}
            >
              选择文件夹并克隆
            </button>
          </div>
        </div>
      </div>
    );
  }

  function renderRenameDialog() {
    if (!renameTarget || !repoPath) return null;
    const next = renameTarget.value.trim();
    const canSubmit =
      next.length > 0 && next !== renameTarget.oldName && !busy;
    const submit = () => {
      if (!canSubmit) return;
      const oldName = renameTarget.oldName;
      setRenameTarget(null);
      void runAction(
        () => api.branchRename(repoPath, oldName, next),
        "正在重命名分鏀…?,
      );
    };
    return (
      <div className="modal-mask" onClick={() => setRenameTarget(null)}>
        <div
          className="modal sync-modal"
          onClick={(event) => event.stopPropagation()}
          role="dialog"
          aria-modal="true"
          aria-labelledby="rename-branch-title"
        >
          <h3 id="rename-branch-title">重命名分鏀?/h3>
          <p className="muted small">
            灏嗐…寋renameTarget.oldName}」重命名为：
          </p>
          <input
            value={renameTarget.value}
            onChange={(e) =>
              setRenameTarget((cur) =>
                cur ? { ...cur, value: e.target.value } : cur,
              )
            }
            onKeyDown={(e) => {
              if (e.key === "Enter" && !e.nativeEvent.isComposing) {
                e.preventDefault();
                submit();
              } else if (e.key === "Escape") {
                e.preventDefault();
                setRenameTarget(null);
              }
            }}
            placeholder="新分鏀悕"
            autoFocus
            onFocus={(e) => e.currentTarget.select()}
            disabled={busy}
          />
          <div className="modal-actions">
            <button
              type="button"
              disabled={busy}
              onClick={() => setRenameTarget(null)}
            >
              取消
            </button>
            <button
              type="button"
              className="primary"
              disabled={!canSubmit}
              onClick={submit}
            >
              重命鍚?            </button>
          </div>
        </div>
      </div>
    );
  }

  function renderCheckoutDialog() {
    if (!checkoutTarget || !repoPath) return null;
    const { commit, branchName } = checkoutTarget;
    const branch = branchName.trim();
    const submit = () => {
      setCheckoutTarget(null);
      withConfirm(
        branch
          ? `浠?${commit.shortHash} 创建并切换到分支銆?{branch}」？`
          : `娓哥妫…出到 ${commit.shortHash}？当前不在任何分鏀笂。`,
        () => {
          void runAction(
            () =>
              api.checkoutCommit(repoPath, commit.hash, branch || null),
            "正在妫…鍑衡…?,
          );
        },
      );
    };
    return (
      <div className="modal-mask" onClick={() => setCheckoutTarget(null)}>
        <div
          className="modal sync-modal"
          onClick={(event) => event.stopPropagation()}
          role="dialog"
          aria-modal="true"
          aria-labelledby="checkout-commit-title"
        >
          <h3 id="checkout-commit-title">妫…出提浜?{commit.shortHash}</h3>
          <p className="muted">{commit.subject}</p>
          <p className="muted small">
            鍙…夛細输入新分鏀悕并创建；留空则游绂绘鍑恒…?          </p>
          <input
            value={branchName}
            onChange={(e) =>
              setCheckoutTarget((cur) =>
                cur ? { ...cur, branchName: e.target.value } : cur,
              )
            }
            onKeyDown={(e) => {
              if (e.key === "Enter" && !e.nativeEvent.isComposing) {
                e.preventDefault();
                submit();
              } else if (e.key === "Escape") {
                e.preventDefault();
                setCheckoutTarget(null);
              }
            }}
            placeholder="新分鏀悕（可留空锛?
            autoFocus
            disabled={busy}
          />
          <div className="modal-actions">
            <button
              type="button"
              disabled={busy}
              onClick={() => setCheckoutTarget(null)}
            >
              取消
            </button>
            <button
              type="button"
              className="primary"
              disabled={busy}
              onClick={submit}
            >
              {branch ? "创建骞舵鍑? : "娓哥妫…鍑?}
            </button>
          </div>
        </div>
      </div>
    );
  }

  function renderResetDialog() {
    if (!resetTarget || !repoPath) return null;
    const short = resetTarget.shortHash;
    const subject = resetTarget.subject;
    const runReset = (mode: "soft" | "mixed" | "hard") => {
      void (async () => {
        if (mode === "hard") {
          const ok = await confirmAction(
            `纭噸缃埌 ${short}？\n工作区和暂存区都会回鍒拌提交，未提交改动将丢失，且无法用鏈伐具恢澶嶃…俙,
            { title: "纭噸缃?, danger: true, confirmLabel: "纭噸缃? },
          );
          if (!ok) return;
        }
        setResetTarget(null);
        void runAction(
          () => api.resetCommit(repoPath, resetTarget.hash, mode),
          mode === "hard"
            ? "正在纭噸缃…?
            : mode === "soft"
              ? "正在杞噸缃…?
              : "正在混合重置鈥?,
        );
      })();
    };
    return (
      <div className="modal-mask" onClick={() => setResetTarget(null)}>
        <div
          className="modal sync-modal"
          onClick={(event) => event.stopPropagation()}
          role="dialog"
          aria-modal="true"
        >
          <h3>重置到提浜?{short}</h3>
          <p className="muted">{subject}</p>
          <p className="muted small">当前分支会指鍒拌提交銆傝选择重置方式锛?/p>
          <div className="sync-choices">
            <button
              type="button"
              className="primary sync-choice"
              disabled={busy}
              onClick={() => runReset("soft")}
            >
              <strong>杞噸缃?/strong>
              <span className="muted small">提交鍥為……，改动仍在暂存区（最安全锛?/span>
            </button>
            <button
              type="button"
              className="sync-choice"
              disabled={busy}
              onClick={() => runReset("mixed")}
            >
              <strong>混合重置</strong>
              <span className="muted small">提交鍥為……，改动回到未暂存（默璁?git reset锛?/span>
            </button>
            <button
              type="button"
              className="danger sync-choice"
              disabled={busy}
              onClick={() => runReset("hard")}
            >
              <strong>纭噸缃?/strong>
              <span className="muted small">提交与文件都回到该版鏈紝鏈彁交改动会丢弃</span>
            </button>
          </div>
          <div className="modal-actions">
            <button type="button" disabled={busy} onClick={() => setResetTarget(null)}>
              取消
            </button>
          </div>
        </div>
      </div>
    );
  }

  function renderPublishDialog() {
    if (!publishDialog) return null;
    const ghOk = Boolean(accounts?.github.loggedIn);
    const geOk = Boolean(accounts?.gitee.loggedIn);
    return (
      <div className="modal-mask" onClick={() => setPublishDialog(null)}>
        <div
          className="modal sync-modal"
          onClick={(event) => event.stopPropagation()}
          role="dialog"
          aria-modal="true"
        >
          <h3>创建远程仓库</h3>
          <p className="muted">
            鏈湴已初始化。可同时鍦?GitHub / Gitee 建空仓库并写入远程地鍧…（需已登录）銆?          </p>
          <label className="field-block">
            <span>仓库鍚?/span>
            <input
              value={publishDraft.name}
              onChange={(e) =>
                setPublishDraft((d) => ({ ...d, name: e.target.value }))
              }
              disabled={busy}
              spellCheck={false}
            />
          </label>
          <div className="publish-checks">
            <label>
              <input
                type="checkbox"
                checked={publishDraft.toGithub}
                disabled={busy || !ghOk}
                onChange={(e) =>
                  setPublishDraft((d) => ({ ...d, toGithub: e.target.checked }))
                }
              />
              GitHub{ghOk ? "" : "（未登录锛?}
            </label>
            <label>
              <input
                type="checkbox"
                checked={publishDraft.toGitee}
                disabled={busy || !geOk}
                onChange={(e) =>
                  setPublishDraft((d) => ({ ...d, toGitee: e.target.checked }))
                }
              />
              Gitee{geOk ? "" : "（未登录锛?}
            </label>
            <label>
              <input
                type="checkbox"
                checked={publishDraft.privateRepo}
                disabled={busy}
                onChange={(e) =>
                  setPublishDraft((d) => ({
                    ...d,
                    privateRepo: e.target.checked,
                  }))
                }
              />
              私有仓库
            </label>
          </div>
          <div className="modal-actions">
            <button type="button" disabled={busy} onClick={() => setPublishDialog(null)}>
              稍后
            </button>
            <button
              type="button"
              className="primary"
              disabled={
                busy ||
                !publishDraft.name.trim() ||
                (!(publishDraft.toGithub && ghOk) &&
                  !(publishDraft.toGitee && geOk))
              }
              onClick={() => {
                const target = publishDialog.path;
                const name = publishDraft.name.trim();
                const toGithub = publishDraft.toGithub && ghOk;
                const toGitee = publishDraft.toGitee && geOk;
                if (!toGithub && !toGitee) return;
                setPublishDialog(null);
                void runAction(
                  () =>
                    api.publishRemotes(target, name, {
                      toGithub,
                      toGitee,
                      privateRepo: publishDraft.privateRepo,
                    }),
                  "正在创建远程仓库鈥?,
                );
              }}
            >
              创建
            </button>
          </div>
        </div>
      </div>
    );
  }

  function renderSyncDialog() {
    if (!syncDialog || !repoPath) return null;
    const unrelated = syncDialog === "unrelated";
    return (
      <div className="modal-mask" onClick={() => setSyncDialog(null)}>
        <div
          className="modal sync-modal"
          onClick={(event) => event.stopPropagation()}
          role="dialog"
          aria-modal="true"
        >
          <h3>{unrelated ? "鏈湴与远程历史不涓…鑷? : "鎺ㄩ…佽拒绝"}</h3>
          <p className="muted">
            {unrelated
              ? "两边没有共同祖先（常见于鏈湴 init 过，GitHub 上也单独建过仓库锛夈…傝选择如何处理锛?
              : "远程有本地还没有的提浜ゃ…傝选择如何处理锛?}
          </p>
          <div className="sync-choices">
            {unrelated ? (
              <>
                <button
                  type="button"
                  className="primary sync-choice"
                  disabled={busy}
                  onClick={() => {
                    setSyncDialog(null);
                    void runAction(async () => {
                      const merged = await api.pull(repoPath, true);
                      try {
                        const pushed = await api.push(repoPath, false);
                        return `${merged}\n${pushed}`;
                      } catch {
                        return `${merged}\n合并完成。若有冲绐佽鍏堝理，然后再点「推閫併…嶃…俙;
                      }
                    }, "正在合并两边历史鈥?);
                  }}
                >
                  <strong>保留两边鍐呭</strong>
                  <span className="muted small">
                    合并互不相关的历史并尝试鎺ㄩ…侊紱若有冲突，可在界面里继续或放寮?                  </span>
                </button>
                <button
                  type="button"
                  className="danger sync-choice"
                  disabled={busy}
                  onClick={() =>
                    withConfirm(
                      "将用鏈湴提交覆盖远程，远绋嬪出来的提交会丢失。确定继缁紵",
                      () => {
                        setSyncDialog(null);
                        void runAction(
                          () =>
                            api.push(repoPath, true, null, activePushRemote),
                          "正在强制鎺ㄩ…佲…?,
                        );
                      },
                    )
                  }
                >
                  <strong>鍙敤鏈湴锛岃盖远绋?/strong>
                  <span className="muted small">强制鎺ㄩ…侊紝远程旧内容会琚浛鎹?/span>
                </button>
              </>
            ) : (
              <>
                <button
                  type="button"
                  className="primary sync-choice"
                  disabled={busy}
                  onClick={() => {
                    setSyncDialog(null);
                    void runAction(async () => {
                      await api.pull(repoPath);
                      return api.push(repoPath, false, null, activePushRemote);
                    }, "正在拉取并推閫佲…?);
                  }}
                >
                  <strong>先拉取再鎺ㄩ…?/strong>
                  <span className="muted small">把远程改动合进来，然后再鎺ㄩ…侊紙推荐锛?/span>
                </button>
                <button
                  type="button"
                  className="danger sync-choice"
                  disabled={busy}
                  onClick={() =>
                    withConfirm(
                      "将用鏈湴提交覆盖远程，远绋嬪出来的提交会丢失。确定继缁紵",
                      () => {
                        setSyncDialog(null);
                        void runAction(
                          () =>
                            api.push(repoPath, true, null, activePushRemote),
                          "正在强制鎺ㄩ…佲…?,
                        );
                      },
                    )
                  }
                >
                  <strong>强制鎺ㄩ…侊紝覆盖远程</strong>
                  <span className="muted small">仅在纭畾不需要远程提交时使用</span>
                </button>
              </>
            )}
          </div>
          <div className="modal-actions">
            <button type="button" disabled={busy} onClick={() => setSyncDialog(null)}>
              取消
            </button>
          </div>
        </div>
      </div>
    );
  }

  function renderSshPanel(provider: AuthProvider) {
    if (provider !== "github" && provider !== "gitee") return null;
    const label = provider === "github" ? "GitHub" : "Gitee";
    const keysUrl =
      provider === "github"
        ? "https://github.com/settings/keys"
        : "https://gitee.com/profile/sshkeys";
    return (
      <div className="auth-ssh-block">
        <div className="auth-token-head">
          <span>SSH 密钥锛堣涓…次即鍙級</span>
          <button
            type="button"
            className="linkish"
            disabled={busy}
            onClick={() => void refreshSsh()}
          >
            刷新
          </button>
        </div>
        <p className="muted small">
          {sshStatus?.tip ??
            "妫…测本鏈?~/.ssh 鍏挜；添加到平台后可鐢?git@ 地址推拉銆?}
        </p>
        {sshStatus?.keys?.length ? (
          <ul className="auth-ssh-keys">
            {sshStatus.keys.map((k) => (
              <li key={k.path}>
                <code className="auth-ssh-path">{k.path}</code>
                <span className="muted small">{k.fingerprint}</span>
                <div className="auth-method-row">
                  <button
                    type="button"
                    disabled={busy}
                    onClick={() => {
                      void navigator.clipboard.writeText(k.publicKey);
                      setNotice("宸插制公閽?);
                    }}
                  >
                    复制鍏挜
                  </button>
                </div>
              </li>
            ))}
          </ul>
        ) : (
          <p className="muted small">鏈壘鍒?id_ed25519 / id_rsa 鍏挜銆?/p>
        )}
        <div className="auth-method-row">
          <button
            type="button"
            disabled={busy}
            onClick={() =>
              void (async () => {
                setBusy(true);
                setError(null);
                try {
                  const next = await api.authSshGenerate();
                  setSshStatus(next);
                  setNotice("已生鎴?ed25519 密钥锛岃复制鍏挜添加到平鍙?);
                } catch (e) {
                  setError(failureLine(e));
                } finally {
                  setBusy(false);
                }
              })()
            }
          >
            生成 ed25519 密钥
          </button>
          <button
            type="button"
            disabled={busy}
            onClick={() => void openUrl(keysUrl)}
          >
            打开 {label} SSH 设置
          </button>
          <button
            type="button"
            disabled={busy}
            onClick={() =>
              void (async () => {
                setBusy(true);
                setError(null);
                setSshFeedback({
                  ok: null,
                  text: `正在测试 ${label} SSH（最多约 20 秒）鈥,
                });
                try {
                  const result = await api.authSshTest(provider);
                  const text =
                    result.message.trim() ||
                    (result.ok ? "SSH 认证成功" : "SSH 鏈…氳繃");
                  setSshFeedback({ ok: result.ok, text });
                  if (result.ok) setNotice(text);
                  else setError(text);
                } catch (e) {
                  const text = failureLine(e);
                  setSshFeedback({ ok: false, text });
                  setError(text);
                } finally {
                  setBusy(false);
                }
              })()
            }
          >
            测试 SSH
          </button>
        </div>
        {sshFeedback && (
          <p
            className={
              sshFeedback.ok === null
                ? "auth-ssh-feedback is-pending"
                : sshFeedback.ok
                  ? "auth-ssh-feedback is-ok"
                  : "auth-ssh-feedback is-bad"
            }
            role="status"
          >
            {sshFeedback.text}
          </p>
        )}
      </div>
    );
  }

  function renderProviderAuth(provider: AuthProvider) {
    const account = accounts?.[provider];
    const draft = drafts[provider];
    const label = provider === "github" ? "GitHub" : "Gitee";
    const tokenDocUrl =
      provider === "github"
        ? "https://github.com/settings/tokens"
        : "https://gitee.com/profile/personal_access_tokens";
    const oauthDocUrl =
      provider === "github"
        ? "https://github.com/settings/developers"
        : "https://gitee.com/oauth/applications";
    const scopeHint =
      provider === "github"
        ? "权限：经鍏?Token 鍕鹃…?repo；细粒度 Token 闇…对应仓库鐨?Contents 读写銆?
        : "权限锛氱人令牌勾閫?projects（以及需要的仓库权限锛夈…?;
    const showLogin = !account?.loggedIn || addingAccount;
    const savedAccounts = account?.accounts ?? [];

      return (
      <div className="auth-login-panel">
        {account?.loggedIn && !addingAccount && (
          <div className="auth-logged-in">
            <div className="github-user auth-user-card">
          {account.avatarUrl ? (
            <img src={account.avatarUrl} alt="" className="github-avatar" />
          ) : (
            <div className="github-avatar placeholder" />
          )}
          <div className="github-user-meta">
            <strong>{account.login}</strong>
                {account.name && (
                  <span className="muted small">{account.name}</span>
                )}
                <span className="muted small">鍑嵁已写入系缁?Git Credential</span>
          </div>
          <button
            type="button"
                className="auth-logout-btn"
            disabled={busy}
            onClick={() => void logoutProvider(provider)}
          >
            閫…鍑?          </button>
        </div>
            {savedAccounts.length > 1 && (
              <div className="auth-account-list">
                <span className="muted small">已保存账鍙?/span>
                {savedAccounts.map((a) => (
                  <button
                    key={a.id}
                    type="button"
                    className={a.active ? "auth-account-item active" : "auth-account-item"}
                    disabled={busy || a.active}
                    onClick={() => void switchAccount(provider, a.id)}
                  >
                    {a.avatarUrl ? (
                      <img src={a.avatarUrl} alt="" />
                    ) : (
                      <span className="auth-account-dot" />
                    )}
                    <span>{a.login}</span>
                    {a.active && <em>当前</em>}
                  </button>
                ))}
              </div>
            )}
            <button
              type="button"
              className="auth-add-account"
              disabled={busy}
              onClick={() => {
                setAddingAccount(true);
                setError(null);
              }}
            >
              添加账号
            </button>
            {renderSshPanel(provider)}
          </div>
        )}

        {showLogin && (
          <>
            {addingAccount && account?.loggedIn && (
          <button
            type="button"
                className="linkish auth-cancel-add"
            disabled={busy}
                onClick={() => {
                  stopDevicePoll();
                  setDeviceFlow(null);
                  setAddingAccount(false);
                }}
              >
                取消添加，返回当前账鍙?              </button>
            )}
            {account?.sessionExpired && (
              <p className="auth-expired">{label} 登录已失效，请重新登褰曘…?/p>
            )}
            <p className="muted small auth-storage-hint">
              登录成功后会写入鏈満 Git 鍑嵁；启动时与推拉失败时会自动同姝ャ…侽Auth Client
              配置保存涓…次即鍙鐢?              {account?.usingBuiltinOauth ? "（当前可用内缃?Client锛? : ""}銆?            </p>

            <div className="auth-method-list" role="group" aria-label="登录方式">
              <button
                type="button"
                className="auth-method-card is-recommend"
                disabled={busy}
                onClick={() => void loginWithGitManager(provider)}
              >
                <span className="auth-method-mark" aria-hidden>
                  Git
                </span>
                <span className="auth-method-text">
                  <strong>
            鐢?Git 登录
                    <em>推荐</em>
                  </strong>
                  <span>
                    {provider === "github"
                      ? "打开系统鍑嵁管理鍣紝用浏览器完成授权"
                      : "读取或填鍐?Gitee 鍑嵁（密鐮佸濉人令牌）"}
                  </span>
                </span>
              </button>
              <button
                type="button"
                className="auth-method-card"
                disabled={busy}
                onClick={() => void loginWithBrowser(provider)}
              >
                <span className="auth-method-mark" aria-hidden>
                  Web
                </span>
                <span className="auth-method-text">
                  <strong>娴忚器登褰?/strong>
                  <span>闇… Client ID + Secret（可配置涓…次）</span>
                </span>
              </button>
              {provider === "github" && (
                <button
                  type="button"
                  className="auth-method-card"
                  disabled={busy || !!deviceFlow}
                  onClick={() => void loginWithDevice()}
                >
                  <span className="auth-method-mark" aria-hidden>
                    鐮?                  </span>
                  <span className="auth-method-text">
                    <strong>璁惧码登褰?/strong>
                    <span>鍙渶 Client ID，在另一璁惧娴忚器输入代鐮?/span>
                  </span>
          </button>
        )}
            </div>

            {provider === "github" && deviceFlow && (
              <div className="auth-device-panel">
                <p className="muted small">
                  打开{" "}
                  <button
                    type="button"
                    className="linkish"
                    onClick={() => void openUrl(deviceFlow.verificationUri)}
                  >
                    {deviceFlow.verificationUri}
                  </button>
                  ，输入下方代码完成授鏉冦…?                </p>
                <p className="device-code">{deviceFlow.userCode}</p>
                <div className="auth-method-row">
                  <button
                    type="button"
                    disabled={busy}
                    onClick={() => {
                      void navigator.clipboard.writeText(deviceFlow.userCode);
                      setNotice("宸插鍒惰备码");
                    }}
                  >
                    复制代码
                  </button>
                  <button
                    type="button"
                    disabled={busy}
                    onClick={() => {
                      stopDevicePoll();
                      setDeviceFlow(null);
                      setDeviceStatus("");
                      setNotice(null);
                    }}
                  >
                    取消
                  </button>
                </div>
                {deviceStatus && (
                  <p className="muted small">{deviceStatus}</p>
                )}
              </div>
            )}

            <div className="auth-token-block">
              <div className="auth-token-head">
          <span>Access Token</span>
                <button
                  type="button"
                  className="linkish"
                  disabled={busy}
                  onClick={() => void openUrl(tokenDocUrl)}
                >
                  如何获取
                </button>
              </div>
              <p className="muted small">{scopeHint}</p>
              <div className="auth-token-row">
          <input
                  type={draft.showToken ? "text" : "password"}
            value={draft.token}
                  onChange={(e) =>
                    updateDraft(provider, { token: e.target.value })
                  }
                  onPaste={(e) => {
                    const text = e.clipboardData.getData("text").trim();
                    if (!text) return;
                    e.preventDefault();
                    updateDraft(provider, { token: text });
                    void loginWithToken(provider, text);
                  }}
            placeholder={
              provider === "github"
                ? "ghp_鈥?/ github_pat_鈥?
                : "Gitee 私人令牌"
            }
            disabled={busy}
            onKeyDown={(e) => {
              if (e.key === "Enter") void loginWithToken(provider);
            }}
          />
        <button
          type="button"
                  className="auth-toggle-vis"
                  disabled={busy}
                  onClick={() =>
                    updateDraft(provider, { showToken: !draft.showToken })
                  }
                >
                  {draft.showToken ? "隐藏" : "显示"}
                </button>
                <button
                  type="button"
                  className="primary auth-token-login"
          disabled={busy || !draft.token.trim()}
          onClick={() => void loginWithToken(provider)}
        >
          鐢?Token 登录
        </button>
              </div>
            </div>

            <button
              type="button"
              className="linkish auth-oauth-toggle"
              disabled={busy}
              onClick={() =>
                updateDraft(provider, { showOauth: !draft.showOauth })
              }
            >
              {draft.showOauth
                ? "收起 OAuth 应用配置"
                : account?.oauthReady
                  ? "OAuth 已就缁紙鍙敼配置锛?
                  : "配置 OAuth锛堣备码鍙渶 Client ID，浏览器还需 Secret锛?}
            </button>
            {draft.showOauth && (
              <div className="auth-oauth-fields">
                <p className="muted small">
                  鍦?{label} 创建 OAuth 应用并保存一次即鍙…傝备码登录鍙渶 Client
                  ID；浏览器登录还需 Secret。回调地鍧…在点「浏览器登录」时由本鏈虹口自动生鎴愩…?                  <button
                    type="button"
                    className="linkish"
                    disabled={busy}
                    onClick={() => void openUrl(oauthDocUrl)}
                  >
                    打开寮…鍙戣…呰缃?                  </button>
                </p>
                <label className="settings-field">
                  <span>Client ID</span>
                  <input
                    value={draft.clientId}
                    onChange={(e) =>
                      updateDraft(provider, { clientId: e.target.value })
                    }
                    disabled={busy}
                    placeholder="OAuth Client ID"
                  />
                </label>
                <label className="settings-field">
                  <span>Client Secret</span>
                  <input
                    type="password"
                    value={draft.clientSecret}
                    onChange={(e) =>
                      updateDraft(provider, { clientSecret: e.target.value })
                    }
                    disabled={busy}
                    placeholder="娴忚器登录需要；璁惧码可留空"
                  />
                </label>
                <button
                  type="button"
                  disabled={busy || !draft.clientId.trim()}
                  onClick={() =>
                    void (async () => {
                      try {
                        const status = await api.authSaveOauthConfig(
                          provider,
                          draft.clientId.trim(),
                          draft.clientSecret.trim(),
                        );
                        applyAccount(status);
                        setNotice(`已保瀛?${label} OAuth 配置`);
                      } catch (e) {
                        setError(failureLine(e));
                      }
                    })()
                  }
                >
                  保存 OAuth 配置
                </button>
              </div>
            )}

            {!account?.loggedIn && renderSshPanel(provider)}
          </>
        )}
      </div>
    );
  }

  if (!repoPath) {
    return (
      <>
        <WindowChrome
          overlay={Boolean(wallpaperUrl) || Boolean(boot)}
          version={appVersion}
          updateAvailable={Boolean(updateInfo?.updateAvailable)}
          updateBusy={updateBusy}
          onCheckUpdate={() => void checkForUpdate(false)}
          onUpdateClick={() => openSettings("about")}
        />
        {boot && (
          <LoadingScreen
            folderName={folderName(boot.path)}
            progress={boot.progress}
            label={boot.label}
            fromCache={boot.fromCache}
            wallpaperUrl={wallpaperUrl}
            wallpaperKind={prefs.wallpaperKind}
          />
        )}
        <div className={`welcome ${wallpaperUrl ? "has-wallpaper" : ""}`}>
          {wallpaperUrl && (
            <div className="welcome-wallpaper" aria-hidden>
              {prefs.wallpaperKind === "video" ? (
                <video
                  className="welcome-media"
                  src={wallpaperUrl}
                  autoPlay
                  muted
                  loop
                  playsInline
                />
              ) : (
                <img className="welcome-media" src={wallpaperUrl} alt="" />
              )}
              <div className="welcome-scrim" />
            </div>
          )}
        <div className="welcome-card">
          <img className="brand-mark" src="/app-icon.png" alt="" width={72} height={72} />
          <h1>青枝</h1>
          <p className="muted">
            打开鏈湴项目，用图形界面完成日常 Git：改鍔ㄣ…佹彁浜ゃ…佸垎鏀笌推拉銆?          </p>
          {gitInfo ? (
            <p className="git-meta">
              {gitInfo.version}
              <br />
              <span className="muted small">{gitInfo.path}</span>
            </p>
          ) : (
            <p className="muted">正在妫…娴?Git銆傚果没有安装，会自动安装完整版 Git for Windows銆?/p>
          )}
          <div className="welcome-actions">
            <button type="button" className="primary" onClick={pickFolder} disabled={busy || !gitInfo}>
              打开文件澶?            </button>
            <button type="button" onClick={() => openSettings()} disabled={busy}>
              设置
            </button>
            <button type="button" onClick={() => setShowHelp(true)} disabled={busy}>
              说明涔?            </button>
            <button type="button" onClick={() => openSettings("about")} disabled={busy}>
              关于
            </button>
            <button type="button" onClick={() => void cloneRepo()} disabled={busy || !gitInfo}>
              克隆
            </button>
          </div>
          {recent.length > 0 && (
            <div className="recent">
              <div className="recent-header">
              <h2>鏈…近打寮…</h2>
                <div className="row-actions">
                  {Object.values(recentExists).some((ok) => ok === false) && (
                    <button
                      type="button"
                      className="linkish"
                      disabled={busy}
                      onClick={() => {
                        const keep = recent.filter((p) => recentExists[p] !== false);
                        setRecent(pruneRecent(keep));
                      }}
                    >
                      清理失效
                    </button>
                  )}
                  <button
                    type="button"
                    className="linkish"
                    disabled={busy}
                    onClick={() =>
                      withConfirm("清空全部鏈…近打寮…记录锛?, () => {
                        setRecent(clearRecent());
                      })
                    }
                  >
                    清空
                  </button>
                </div>
              </div>
              <ul>
                {recent.map((p) => {
                  const missing = recentExists[p] === false;
                  return (
                    <li key={p} className={missing ? "missing" : undefined}>
                      <button
                        type="button"
                        className="recent-open"
                        onClick={() => {
                          if (missing) {
                            setError(`璺緞不存鍦細${p}`);
                            return;
                          }
                          void openFolder(p);
                        }}
                        disabled={busy}
                        title={missing ? "璺緞已失鏁? : p}
                      >
                        <span className="recent-path">{p}</span>
                        {missing ? (
                          <span className="recent-badge">失效</span>
                        ) : null}
                      </button>
                      <button
                        type="button"
                        className="recent-remove"
                        disabled={busy}
                        title="从列表移闄?
                        aria-label="从列表移闄?
                        onClick={() => setRecent(removeRecent(p))}
                      >
                        ×
                    </button>
                  </li>
                  );
                })}
              </ul>
            </div>
          )}
          {error && <div className="error-box" title={error}>{error}</div>}
          {updateInfo?.updateAvailable &&
            updateInfo.tagName !== dismissedUpdateTag && (
            <div className="update-banner" role="status">
              <div className="update-banner-text">
                发现新版鏈?<strong>v{updateInfo.latestVersion}</strong>
              </div>
              <div className="update-banner-actions">
                <button
                  type="button"
                  className="primary"
                  disabled={updateBusy || busy}
                  onClick={() => void downloadAndInstallUpdate()}
                >
                  下载并安瑁?                </button>
                <button type="button" onClick={() => openSettings("about")}>
                  关于
                </button>
              </div>
            </div>
          )}
          <div className="welcome-terminal">
            <Terminal
              text={terminal}
              onClear={() => setTerminal("")}
              wallpaperUrl={terminalWallpaperUrl}
              wallpaperKind={prefs.terminalWallpaperKind}
              wallpaperScrim={prefs.terminalWallpaperScrim}
            />
          </div>
        </div>
        {showSettings && renderSettings()}
        {showHelp && renderHelp()}
        {showAbout && renderAbout()}
      </div>
      </>
    );
  }

  function renderAbout() {
    const hasUpdate = Boolean(updateInfo?.updateAvailable);
    return (
      <div className="modal-mask" onClick={() => setShowSettings(false)}>
        <div
          className="modal about-modal"
          onClick={(event) => event.stopPropagation()}
          role="dialog"
          aria-modal="true"
          aria-label="关于青枝"
        >
          <header className="about-modal-head">
            <div>
              <h3>关于青枝</h3>
              <p className="muted small">鏈湴 Git 桌面工具 · 寮…源，绂佹商用</p>
            </div>
            <button
              type="button"
              className="settings-close"
              onClick={() => setShowSettings(false)}
              aria-label="关闭"
            >
              关闭
            </button>
          </header>
          <div className="settings-card about-card">
            <div className="about-brand">青枝</div>
            <p className="about-line">
              <span>当前版本</span>
              <strong>v{appVersion}</strong>
            </p>
            <p className="about-line">
              <span>浣滆…?/span>
              <strong>理智护发</strong>
            </p>
            <p className="about-line">
              <span>閭</span>
              <button
                type="button"
                className="linkish about-mail"
                onClick={() => void openUrl("mailto:lizhihufa@163.com")}
              >
                lizhihufa@163.com
              </button>
            </p>
          </div>

          <div className="settings-card about-feedback">
            <h5>杞欢更新</h5>
            <p className="muted small">
              浠?GitHub（{UPDATE_REPO_OWNER}/{UPDATE_REPO_NAME}锛夋测最鏂?Release銆?            </p>
            {hasUpdate ? (
              <p className="about-update-tip">
                发现新版鏈?<strong>v{updateInfo!.latestVersion}</strong>
                {updateInfo!.name ? ` · ${updateInfo!.name}` : ""}
              </p>
            ) : updateInfo ? (
              <p className="muted small">当前已是鏈…新版鏈…?/p>
            ) : null}
            {updateInfo?.body ? (
              <pre className="about-release-notes">{updateInfo.body}</pre>
            ) : null}
            {updateProgress && (
              <div className="about-progress">
                <div className="about-progress-head">
                  <span>{updateProgress.label}</span>
                  <span>{updateProgress.percent}%</span>
                </div>
                <div className="about-progress-bar">
                  <i style={{ width: `${updateProgress.percent}%` }} />
                </div>
              </div>
            )}
            <div className="about-actions">
              <button
                type="button"
                disabled={updateBusy || busy}
                onClick={() => void checkForUpdate(false)}
              >
                妫…查更鏂?              </button>
              {hasUpdate && (
              <button
                type="button"
                  className="primary"
                  disabled={updateBusy || busy}
                  onClick={() => void downloadAndInstallUpdate()}
              >
                  下载并安瑁?              </button>
              )}
              {updateInfo?.htmlUrl && (
                <button
                  type="button"
                  className="linkish"
                  disabled={updateBusy}
                  onClick={() => void openUrl(updateInfo.htmlUrl)}
                >
                  打开 Release 页面
                </button>
              )}
            </div>
          </div>

          <div className="settings-card about-feedback">
            <h5>遇到闂锛?/h5>
            <p className="muted small">
              请截图界闈紝并简瑕佽明操浣滄骤与报错鍐呭，发送到浣滆…呴偖绠便…傛敹到后会尽蹇洖澶嶃…?            </p>
            <button
              type="button"
              className="primary about-feedback-btn"
              onClick={() =>
                void openUrl(
                  "mailto:lizhihufa@163.com?subject=%E9%9D%92%E6%9E%9D%E9%97%AE%E9%A2%98%E5%8F%8D%E9%A6%88&body=%E8%AF%B7%E9%99%84%E4%B8%8A%E6%88%AA%E5%9B%BE%EF%BC%8C%E5%B9%B6%E8%AF%B4%E6%98%8E%EF%BC%9A%0A1.%20%E5%81%9A%E4%BA%86%E4%BB%80%E4%B9%88%0A2.%20%E5%87%BA%E7%8E%B0%E4%BA%86%E4%BB%80%E4%B9%88%0A3.%20%E6%9C%9F%E6%9C%9B%E7%BB%93%E6%9E%9C%0A",
                )
              }
            >
              写邮件反棣?            </button>
            <button
              type="button"
              className="about-copy-mail"
              onClick={() => {
                void navigator.clipboard.writeText("lizhihufa@163.com");
                setNotice("宸插制邮绠?);
              }}
            >
              复制閭
            </button>
          </div>
        </div>
      </div>
    );
  }

  function renderHelp() {
    return (
      <div className="modal-mask" onClick={() => setShowHelp(false)}>
        <div
          className="modal help-modal"
          onClick={(event) => event.stopPropagation()}
          role="dialog"
          aria-modal="true"
        >
          <h3>青枝 · 全部操作说明</h3>
          <div className="help-body">
            <h4>欢迎椤?/h4>
            <ul>
              <li>打开文件夹：打开鏈湴项目；非仓库时可鍒濆化（榛樿分支 main锛夈…?/li>
              <li>克隆：填写地鍧…后可选分鏀?/ 浅克隆深度，鍐嶉…夌┖文件夹克隆并打开銆?/li>
              <li>鏈…近打寮…：再寮…仓库锛浢?移除单项；可清空 / 清理失效璺緞銆?/li>
            </ul>
            <h4>工具鏍?/h4>
            <ul>
              <li>打开 / 刷新：换项目或重鏂拌取状态（F5、Ctrl+R锛夈…?/li>
              <li>关于：当前版鏈…佹查更鏂般…佷笅载安瑁呫…?/li>
              <li>下方「Release」页锛氱鐞?GitHub Release 附件（上浼?删除瀹夎包）銆?/li>
              <li>获取：只下载远程，不改本地文浠躲…?/li>
              <li>拉取：合并拉取或变基拉取（▾ 切换；Ctrl+Shift+L锛夈…?/li>
              <li>鎺ㄩ…侊細直接鎺ㄩ…?/ 鍚屾另一平台 / 强制鎺ㄩ…侊紙▾；Ctrl+Shift+P锛夈…?/li>
              <li>鍚屾方式锛氳缃噷鍙…夈…屽簲用内鍚屾」或「GitHub Actions 镜像」（GitHub→Gitee锛夈…?/li>
              <li>克隆：可指定分支、浅克隆深度銆?/li>
              <li>↑↓ 数字：相对远程超鍓?/ 落后的提交数銆?/li>
            </ul>
            <h4>改动与提浜?/h4>
            <ul>
              <li>绛涢…夛細按路寰勩…佸啿绐併…佹湭跟踪过滤銆?/li>
              <li>暂存 / 全部暂存（Ctrl+S）：放入暂存区；取消：移出暂存区銆?/li>
              <li>放弃：丢弃工作区淇敼或删除未跟踪文件（需纭锛夈…?/li>
              <li>忽略：写鍏?.gitignore；历史：查看单文件提浜よ褰曘…?/li>
              <li>宸紓椤点…屾殏瀛樻鍧?/ 取消此块 / 放弃此块」：按改动块操作銆?/li>
              <li>提交（Ctrl+Enter）：用已暂存文件创建提交（需名字閭锛夈…?/li>
              <li>淇敼涓婃：改写最近未鎺ㄩ…佹彁交；撤销涓婃：去鎺夎提交，改动回暂存鍖恒…?/li>
            </ul>
            <h4>分支</h4>
            <ul>
              <li>点击分支：切鎹紱新建：创建并切过去；重命名；清理鏈窡韪枃浠躲…?/li>
              <li>删除：删鏈湴分支；未合并时会询问鏄惁强制删除；当前分鏀彲銆岃上游銆嶃…?/li>
              <li>合并：把鎵…选分鏀苟入当前；变基：把当前接到鎵…选分鏀箣后（改写历史锛夈…?/li>
              <li>远程妫…鍑?/ 删除：基于远程建鏈湴分支，或删除远程分支銆?/li>
              <li>冲突时（合并/鎷ｉ…?变基/还原）：编辑并暂瀛?鈫掋…岀户缁…嶏紱鎴栥…屾斁寮冦…嶄腑姝…?/li>
            </ul>
            <h4>历史 / 储藏 / 鏍囩 / 缁堢</h4>
            <ul>
              <li>历史：搜索提交；鎷ｉ…?/ 还原 / 妫…鍑?/ 重置；可比较两个引用銆?/li>
              <li>储藏：查鐪嬨…佸簲鐢ㄣ…佸脊出或丢弃；可选含鏈窡韪枃浠躲…?/li>
              <li>鏍囩：创建（鍙～附注锛夈…佹帹閫併…佹帹送全閮ㄣ…佸垹鏈湴、删远程銆?/li>
              <li>缁堢（默认页）：显示界面对应鐨?git 输出，也鍙墜输命浠ゃ…?/li>
            </ul>
            <h4>设置</h4>
            <ul>
              <li>涓婚、字浣撱…佹渶近打寮…、提交图、仓库缓存加閫熴…?/li>
              <li>壁纸锛氭迎页/加载页与缁堢鍙垎鍒缃儗鏅…?/li>
              <li>GitHub / Gitee：Git 登录、浏览器 OAuth、Token；工具栏鍙湅登录鐘舵…併…?/li>
              <li>韬唤与远程：名字閭、origin、克隆地鍧…；点「保瀛樸…嶄竴并写鍏ャ…?/li>
            </ul>
            <h4>多仓库与安全</h4>
            <ul>
              <li>顶部鏍囩切换多个仓库锛浢?关闭鏍囩（不鍒犵盘）銆?/li>
              <li>纭噸缃…佸己制推閫併…佸垹远程分支/鏍囩会有纭锛岃谨慎銆?/li>
              <li>操作过久时界闈細鑷姩鎭㈠，可看终绔垨点刷鏂般…?/li>
            </ul>
            <p className="muted small">
              更完整的表格说明见安装目录中鐨勩…婁娇鐢ㄨ明书.md銆嬨…?            </p>
          </div>
          <div className="modal-actions">
            <button type="button" className="primary" onClick={() => setShowHelp(false)}>
              关闭
            </button>
          </div>
        </div>
      </div>
    );
  }

  function renderSettings() {
    const navItems: {
      id: "appearance" | "auth" | "identity";
      title: string;
      desc: string;
    }[] = [
      { id: "appearance", title: "澶栬涓庤涓?, desc: "涓婚銆佸纸与习惯" },
      { id: "auth", title: "账号登录", desc: "GitHub / Gitee" },
      { id: "identity", title: "韬唤与远绋?, desc: "名字、邮绠便…佸湴鍧…" },
    ];
    const authLogged =
      (accounts?.github.loggedIn ? 1 : 0) + (accounts?.gitee.loggedIn ? 1 : 0);

    return (
      <div className="modal-mask" onClick={() => setShowSettings(false)}>
        <div
          className="modal settings-modal settings-shell"
          onClick={(event) => event.stopPropagation()}
          role="dialog"
          aria-modal="true"
          aria-label="设置"
        >
          <header className="settings-shell-head">
            <div>
              <h3>设置</h3>
              <p className="muted small">按分绫荤鐞嗗瑙傘…佺櫥录与仓库韬唤</p>
            </div>
            <button
              type="button"
              className="settings-close"
              onClick={() => setShowSettings(false)}
              aria-label="关闭设置"
            >
              关闭
            </button>
          </header>

          <div className="settings-shell-body">
            <nav className="settings-nav" aria-label="设置分类">
              {navItems.map((item) => (
                <button
                  key={item.id}
                  type="button"
                  className={`settings-nav-item${
                    settingsPage === item.id ? " is-active" : ""
                  }`}
                  onClick={() => setSettingsPage(item.id)}
                >
                  <span className="settings-nav-title">
                    {item.title}
                    {item.id === "auth" && authLogged > 0 && (
                      <span className="settings-nav-badge">{authLogged}</span>
                    )}
                    {item.id === "auth" && sessionWarnings.length > 0 && (
                      <span className="settings-nav-badge is-warn">!</span>
                    )}
                  </span>
                  <span className="settings-nav-desc">{item.desc}</span>
                </button>
              ))}
            </nav>

            <div className="settings-pane">
              {settingsPage === "appearance" && (
                <section className="settings-section">
                  <div className="settings-pane-intro">
                    <h4>澶栬涓庤涓?/h4>
                    <p className="muted small">调整界面观感与打寮…仓库时的习惯銆?/p>
                  </div>
                  <div className="settings-grid-2">
          <label className="settings-field">
                      <span>涓婚</span>
                      <select
                        value={prefs.theme}
                        onChange={(e) =>
                          updatePrefs({
                            theme: e.target.value as AppPrefs["theme"],
                          })
                        }
                      >
                        {THEME_OPTIONS.map((t) => (
                          <option key={t.id} value={t.id}>
                            {t.label}
                          </option>
                        ))}
                      </select>
                    </label>
                    <label className="settings-field">
                      <span>字体大小</span>
                      <select
                        value={prefs.fontSize}
                        onChange={(e) =>
                          updatePrefs({
                            fontSize: e.target.value as AppPrefs["fontSize"],
                          })
                        }
                      >
                        <option value="normal">标准</option>
                        <option value="large">较大</option>
                      </select>
                    </label>
                  </div>

                  <div className="pref-cards" role="group" aria-label="行为选项">
                    <label
                      className={`pref-card${prefs.rememberRecent ? " is-on" : ""}`}
                    >
            <input
                        type="checkbox"
                        checked={prefs.rememberRecent}
              onChange={(e) =>
                          updatePrefs({ rememberRecent: e.target.checked })
              }
            />
                      <span className="pref-card-text">
                        <strong>记住鏈…近打寮…</strong>
                        <span>欢迎页保留最近打寮…过的仓库璺緞</span>
                      </span>
                      <span className="pref-switch" aria-hidden />
          </label>
                    <label
                      className={`pref-card${prefs.showCommitGraph ? " is-on" : ""}`}
                    >
            <input
                        type="checkbox"
                        checked={prefs.showCommitGraph}
              onChange={(e) =>
                          updatePrefs({ showCommitGraph: e.target.checked })
              }
            />
                      <span className="pref-card-text">
                        <strong>历史页提交图</strong>
                        <span>在历史列表左侧显示分鏀溅道图</span>
                      </span>
                      <span className="pref-switch" aria-hidden />
          </label>
                    <label
                      className={`pref-card${prefs.useRepoCache ? " is-on" : ""}`}
                    >
                <input
                  type="checkbox"
                        checked={prefs.useRepoCache}
                        onChange={(e) =>
                          updatePrefs({ useRepoCache: e.target.checked })
                        }
                      />
                      <span className="pref-card-text">
                        <strong>打开缓存鍔犻…?/strong>
                        <span>鍐嶆打开同一仓库时先用本地快鐓?/span>
                      </span>
                      <span className="pref-switch" aria-hidden />
              </label>
                    <button
                      type="button"
                      className="pref-cache-clear"
                      disabled={busy}
                      onClick={() => {
                        clearRepoCache();
                        setNotice("已清空仓库缓瀛?);
                      }}
                    >
                      清空仓库缓存
                    </button>
                  </div>

                  <div className="settings-card mirror-method-card">
                    <h4>鍚屾鎺ㄩ…佹柟寮?/h4>
                    <p className="muted small">
                      「推送到 Gitee / GitHub」时锛岄…夋嫨鏈満再推涓…次，或只鐢?GitHub
                      Actions 镜像鍒?Gitee（仅 GitHub 鈫?Gitee锛夈…?                    </p>
                    <div className="pref-cards" role="radiogroup" aria-label="鍚屾鎺ㄩ…佹柟寮?>
                      <label
                        className={`pref-card${
                          prefs.mirrorSyncMethod === "app" ? " is-on" : ""
                        }`}
                      >
                        <input
                          type="radio"
                          name="mirrorSyncMethod"
                          checked={prefs.mirrorSyncMethod === "app"}
                          onChange={() =>
                            updatePrefs({ mirrorSyncMethod: "app" })
                          }
                        />
                        <span className="pref-card-text">
                          <strong>应用内同步推閫?/strong>
                          <span>先推榛樿远程，再由青枝推到另涓…平台</span>
                        </span>
                        <span className="pref-switch" aria-hidden />
                      </label>
                      <label
                        className={`pref-card${
                          prefs.mirrorSyncMethod === "actions" ? " is-on" : ""
                        }`}
                      >
                        <input
                          type="radio"
                          name="mirrorSyncMethod"
                          checked={prefs.mirrorSyncMethod === "actions"}
                          onChange={() =>
                            updatePrefs({ mirrorSyncMethod: "actions" })
                          }
                        />
                        <span className="pref-card-text">
                          <strong>GitHub Actions 镜像</strong>
                          <span>鍙帹 GitHub，由 Actions 鑷姩鍚屾鍒?Gitee</span>
                        </span>
                        <span className="pref-switch" aria-hidden />
                      </label>
                    </div>
                    <div className="row-actions" style={{ marginTop: "0.5rem" }}>
                      <button
                        type="button"
                        className="primary"
                        disabled={busy || !repoPath}
                        title="写入 workflow、确淇?Gitee 仓，并尝试配缃?Secrets"
                        onClick={() => {
                          if (!repoPath) return;
                          void runAction(async () => {
                            const result = await api.setupActionsMirror(
                              repoPath,
                              true,
                            );
                            if (result.secretsUrl && !result.secretConfigured) {
                              void openUrl(result.secretsUrl);
                            }
                            updatePrefs({ mirrorSyncMethod: "actions" });
                            return result.message;
                          }, "正在瀹夎 Actions 镜像鈥?);
                        }}
                      >
                        瀹夎 Actions 镜像
                      </button>
                      <button
                        type="button"
                        disabled={busy || !repoPath}
                        onClick={() => {
                          if (!repoPath) return;
                          void runAction(async () => {
                            const status =
                              await api.getActionsMirrorStatus(repoPath);
                            if (status.secretsUrl) {
                              void openUrl(status.secretsUrl);
                            }
                            return status.workflowExists
                              ? `工作流已存在锛?{status.workflowPath}`
                              : "尚未瀹夎工作流，请先鐐广…屽畨瑁?Actions 镜像銆嶃…?;
                          }, "正在妫…鏌?Actions鈥?);
                        }}
                      >
                        打开 Secrets 椤?                      </button>
                    </div>
                    <p className="muted small" style={{ marginTop: "0.4rem" }}>
                      瀹夎鍚庤提交并推閫?workflow 文件；GitHub 登录闇…鍚?                      workflow 权限（可重新授权锛夈…侴itee 鈫?GitHub
                      仍使用应用内鍚屾銆?                    </p>
                  </div>

                  <div className="wallpaper-panel">
                    <div className="wallpaper-panel-head">
                      <h4>加载椤靛绾?/h4>
                      <p className="muted small">
                        用于欢迎页与打开仓库时的加载页（与终绔儗鏅垎寮…设置锛夈…?                      </p>
                    </div>
                    <div className="wallpaper-preview-frame">
                      {prefs.wallpaperKind === "image" && wallpaperUrl ? (
                        <img
                          className="wallpaper-preview-media"
                          src={wallpaperUrl}
                          alt="加载椤靛绾搁瑙?
                        />
                      ) : prefs.wallpaperKind === "video" && wallpaperUrl ? (
                        <video
                          className="wallpaper-preview-media"
                          src={wallpaperUrl}
                          muted
                          autoPlay
                          loop
                          playsInline
                        />
                      ) : (
                        <div className="wallpaper-preview-empty">
                          <span>暂未设置加载椤靛绾?/span>
                          <span className="muted small">选择图片鎴栬棰?/span>
                        </div>
                      )}
                      {prefs.wallpaperKind !== "none" && (
                        <span className="wallpaper-preview-badge">
                          {prefs.wallpaperKind === "video" ? "瑙嗛" : "图片"}
                        </span>
                      )}
                    </div>
                    <div className="row-actions wallpaper-actions">
                      <button
                        type="button"
                        className="primary"
                        disabled={busy}
                        onClick={() => {
                          void (async () => {
                            const selected = await open({
                              multiple: false,
                              title: "选择加载椤靛绾?,
                              filters: [
                                {
                                  name: "媒体",
                                  extensions: [
                                    "png",
                                    "jpg",
                                    "jpeg",
                                    "webp",
                                    "gif",
                                    "mp4",
                                    "webm",
                                    "mov",
                                  ],
                                },
                              ],
                            });
                            if (typeof selected !== "string") return;
                            try {
                              const saved = await api.importWallpaper(
                                selected,
                                "load",
                              );
                              const kind = mediaKindFromPath(saved);
                              updatePrefs({
                                wallpaperPath: saved,
                                wallpaperKind: kind,
                              });
                              setNotice(
                                kind === "video"
                                  ? "宸茶缃姞载页瑙嗛壁纸"
                                  : "宸茶缃姞载页图片壁纸",
                              );
                            } catch (e) {
                              setError(failureLine(e));
                            }
                          })();
                        }}
                      >
                        选择壁纸
                      </button>
                      <button
                        type="button"
                        disabled={busy || prefs.wallpaperKind === "none"}
                        onClick={() => {
                          void (async () => {
                            try {
                              await api.clearWallpaper("load");
                            } catch {
                              /* ignore */
                            }
                            updatePrefs({
                              wallpaperPath: "",
                              wallpaperKind: "none",
                            });
                            setNotice("已清除加载页壁纸");
                          })();
                        }}
                      >
                        清除
              </button>
                    </div>
                    <div
                      className={`wallpaper-sliders${
                        prefs.wallpaperKind === "none" ? " is-disabled" : ""
                      }`}
                    >
                      <label className="wallpaper-slider-row">
                        <span>
                          <em>加载页蒙灞?/em>
                          <strong>{prefs.wallpaperLoadScrim}%</strong>
                        </span>
                        <input
                          type="range"
                          min={0}
                          max={90}
                          value={prefs.wallpaperLoadScrim}
                          disabled={prefs.wallpaperKind === "none"}
                          onChange={(e) =>
                            updatePrefs({
                              wallpaperLoadScrim: Number(e.target.value),
                            })
                          }
                        />
                        <span className="muted small">
                          鏁板…艰秺大，欢迎椤?加载椤靛纸越娣?                        </span>
                      </label>
                    </div>
                  </div>

                  <div className="wallpaper-panel">
                    <div className="wallpaper-panel-head">
                      <h4>缁堢背景</h4>
                      <p className="muted small">
                        仅作用于「终绔…嶉〉，与加载椤靛纸互不影鍝嶃…?                      </p>
                    </div>
                    <div className="wallpaper-preview-frame">
                      {prefs.terminalWallpaperKind === "image" &&
                      terminalWallpaperUrl ? (
                        <img
                          className="wallpaper-preview-media"
                          src={terminalWallpaperUrl}
                          alt="缁堢背景棰勮"
                        />
                      ) : prefs.terminalWallpaperKind === "video" &&
                        terminalWallpaperUrl ? (
                        <video
                          className="wallpaper-preview-media"
                          src={terminalWallpaperUrl}
                          muted
                          autoPlay
                          loop
                          playsInline
                        />
                      ) : (
                        <div className="wallpaper-preview-empty">
                          <span>暂未设置缁堢背景</span>
                          <span className="muted small">选择图片鎴栬棰?/span>
                        </div>
                      )}
                      {prefs.terminalWallpaperKind !== "none" && (
                        <span className="wallpaper-preview-badge">
                          {prefs.terminalWallpaperKind === "video"
                            ? "瑙嗛"
                            : "图片"}
                        </span>
                      )}
                    </div>
                    <div className="row-actions wallpaper-actions">
                      <button
                        type="button"
                        className="primary"
                        disabled={busy}
                        onClick={() => {
                          void (async () => {
                            const selected = await open({
                              multiple: false,
                              title: "选择缁堢背景",
                              filters: [
                                {
                                  name: "媒体",
                                  extensions: [
                                    "png",
                                    "jpg",
                                    "jpeg",
                                    "webp",
                                    "gif",
                                    "mp4",
                                    "webm",
                                    "mov",
                                  ],
                                },
                              ],
                            });
                            if (typeof selected !== "string") return;
                            try {
                              const saved = await api.importWallpaper(
                                selected,
                                "terminal",
                              );
                              const kind = mediaKindFromPath(saved);
                              updatePrefs({
                                terminalWallpaperPath: saved,
                                terminalWallpaperKind: kind,
                              });
                              setNotice(
                                kind === "video"
                                  ? "宸茶缃粓绔频背鏅?
                                  : "宸茶缃粓绔浘片背鏅?,
                              );
                            } catch (e) {
                              setError(failureLine(e));
                            }
                          })();
                        }}
                      >
                        选择背景
                      </button>
                      <button
                        type="button"
                        disabled={
                          busy || prefs.terminalWallpaperKind === "none"
                        }
                        onClick={() => {
                          void (async () => {
                            try {
                              await api.clearWallpaper("terminal");
                            } catch {
                              /* ignore */
                            }
                            updatePrefs({
                              terminalWallpaperPath: "",
                              terminalWallpaperKind: "none",
                            });
                            setNotice("已清除终绔儗鏅?);
                          })();
                        }}
                      >
                        清除
                      </button>
                    </div>
                    <div
                      className={`wallpaper-sliders${
                        prefs.terminalWallpaperKind === "none"
                          ? " is-disabled"
                          : ""
                      }`}
                    >
                      <label className="wallpaper-slider-row">
                        <span>
                          <em>缁堢蒙层</em>
                          <strong>{prefs.terminalWallpaperScrim}%</strong>
                        </span>
            <input
                          type="range"
                          min={0}
                          max={90}
                          value={prefs.terminalWallpaperScrim}
                          disabled={prefs.terminalWallpaperKind === "none"}
                          onChange={(e) =>
                            updatePrefs({
                              terminalWallpaperScrim: Number(e.target.value),
                            })
                          }
                        />
                        <span className="muted small">
                          鏁板…艰秺大，缁堢背景越淡、文字越清晰
                        </span>
          </label>
                    </div>
                  </div>

                  <div className="settings-card">
                    <h5>Release 仓库</h5>
          <p className="muted small">
                      管理 GitHub Release 时使用的仓库。留空则鑷姩用当前打寮…仓库鐨?                      origin（仅 GitHub锛夈…傞潚枝自韬殑銆屾查更鏂般…嶄粛固定为{" "}
                      {UPDATE_REPO_OWNER}/{UPDATE_REPO_NAME}銆?                    </p>
          <label className="settings-field">
                      <span>手动指定（owner/repo锛?/span>
            <input
                        value={prefs.releaseRepoOverride}
                        onChange={(e) =>
                          updatePrefs({ releaseRepoOverride: e.target.value })
                        }
                        placeholder="渚嬪 lizhihufa/huaweiyunapp，留绌?当前仓库"
                        spellCheck={false}
            />
          </label>
                    <p className="muted small">
                      当前生效锛?                      {releaseTarget.owner
                        ? `${formatGithubOwnerRepo(
                            releaseTarget.owner,
                            releaseTarget.repo,
                          )}锛?{
                            releaseTarget.source === "settings"
                              ? "设置指定"
                              : "当前仓库远程"
                          }）`
                        : "鏈瘑鍒埌 GitHub 仓库锛岃濉啓上方或配缃?origin"}
                    </p>
                  </div>
                </section>
              )}

              {settingsPage === "auth" && (
                <section className="settings-section" ref={authSectionRef}>
                  <div className="settings-pane-intro">
                    <h4>账号登录</h4>
          <p className="muted small">
                      推荐「用 Git 登录」或粘贴 Token。浏览器登录闇…先配缃?OAuth銆?                      登录写入系统 Git 鍑嵁锛岄……出时会尽量清闄ゃ…?                    </p>
                  </div>
                  {sessionWarnings.length > 0 && (
                    <p className="auth-expired">
                      {sessionWarnings.join("銆?)} 登录已失效，请重新登褰曘…?                    </p>
                  )}
                  <div className="auth-tabs" role="tablist" aria-label="登录平台">
                    <button
                      type="button"
                      role="tab"
                      aria-selected={authTab === "github"}
                      className={authTab === "github" ? "active" : ""}
                      onClick={() => setAuthTab("github")}
                    >
                      <span className="auth-tab-label">GitHub</span>
                      {accounts?.github.loggedIn ? (
                        <span className="auth-tab-badge is-ok">已登褰?/span>
                      ) : accounts?.github.sessionExpired ? (
                        <span className="auth-tab-badge is-warn">已失鏁?/span>
                      ) : null}
                    </button>
                    <button
                      type="button"
                      role="tab"
                      aria-selected={authTab === "gitee"}
                      className={authTab === "gitee" ? "active" : ""}
                      onClick={() => setAuthTab("gitee")}
                    >
                      <span className="auth-tab-label">Gitee</span>
                      {accounts?.gitee.loggedIn ? (
                        <span className="auth-tab-badge is-ok">已登褰?/span>
                      ) : accounts?.gitee.sessionExpired ? (
                        <span className="auth-tab-badge is-warn">已失鏁?/span>
                      ) : null}
            </button>
                  </div>
                  {renderProviderAuth(authTab)}
                </section>
              )}

              {settingsPage === "identity" && (
                <IdentityRemotePane
                  key={repoPath ?? "no-repo"}
                  repoPath={repoPath}
                  remotesCount={remotes.length}
                  remotes={remotes}
                  initialName={identity.name}
                  initialEmail={identity.email}
                  initialRemote={remoteUrl}
                  initialClone={cloneUrl}
                  saveGlobally={saveGlobally}
                  busy={busy}
                  onSaveGloballyChange={setSaveGlobally}
                  onRemoveRemote={(name) => {
                    withConfirm(`删除远程銆?{name}」？`, () => {
                      void runAction(
                        () => api.removeRemote(repoPath!, name),
                        "正在删除远程鈥?,
                      );
                    });
                  }}
                  onAddRemote={(name, url) => {
                    void runAction(
                      () => api.saveRemote(repoPath!, name, url),
                      "正在添加远程鈥?,
                    );
                  }}
                  onDraftChange={onIdentityDraftChange}
                  onSave={saveIdentityAndRemote}
                />
              )}

            </div>
          </div>
        </div>
      </div>
    );
  }

  return (
    <>
      <WindowChrome
        overlay={Boolean(boot && wallpaperUrl)}
        version={appVersion}
        updateAvailable={Boolean(updateInfo?.updateAvailable)}
        updateBusy={updateBusy}
        onCheckUpdate={() => void checkForUpdate(false)}
        onUpdateClick={() => openSettings("about")}
      />
      {boot && (
        <LoadingScreen
          folderName={folderName(boot.path)}
          progress={boot.progress}
          label={boot.label}
          fromCache={boot.fromCache}
          wallpaperUrl={wallpaperUrl}
          wallpaperKind={prefs.wallpaperKind}
        />
      )}
      <div className={`app${entering ? " app-enter" : ""}`}>
      {syncingCache && (
        <div className="sync-strip" role="status">
          <div className="sync-strip-bar" />
          <span>正在后台鍚屾鏈…新状鎬佲…?/span>
        </div>
      )}
      <header className="toolbar">
        <div className="toolbar-left">
          <button type="button" onClick={pickFolder} disabled={busy} title="打开其他项目文件澶?>
            打开鈥?          </button>
          <button
            type="button"
            onClick={() => refresh(repoPath)}
            disabled={busy}
            title="重新读取仓库鐘舵…侊紙F5 / Ctrl+R锛?
          >
            刷新
          </button>
          <button type="button" onClick={() => openSettings()} disabled={busy}>
            设置
          </button>
          <button type="button" onClick={() => setShowHelp(true)} disabled={busy}>
            说明涔?          </button>
          <button
            type="button"
            onClick={() => openSettings("about")}
            disabled={busy}
            title={`关于青枝 v${appVersion}`}
          >
            关于
          </button>
          <div className="repo-title">
            <strong title={repoPath ?? undefined}>{status?.branch ?? "鈥?}</strong>
            <span className="muted small repo-path" title={repoPath ?? undefined}>
              {folderName(repoPath)}
            </span>
            {status && (ahead > 0 || behind > 0) && (
              <span className="sync-badge" title="鐩稿远程：本地超鍓?/ 落后">
                {ahead > 0 ? `鈫?{ahead}` : ""}
                {ahead > 0 && behind > 0 ? " " : ""}
                {behind > 0 ? `鈫?{behind}` : ""}
              </span>
            )}
          </div>
        </div>
        <div className="toolbar-right">
          <button
            type="button"
            className={`auth-chip${
              accounts?.github.loggedIn || accounts?.gitee.loggedIn
                ? " is-in"
                : sessionWarnings.length > 0
                  ? " is-warn"
                  : ""
            }`}
            disabled={busy}
            title="远程账号登录"
            onClick={() => openSettingsAuth()}
          >
            {accounts?.github.loggedIn || accounts?.gitee.loggedIn
              ? [
                  accounts?.github.loggedIn ? `GH:${accounts.github.login}` : null,
                  accounts?.gitee.loggedIn ? `码云:${accounts.gitee.login}` : null,
                ]
                  .filter(Boolean)
                  .join(" · ")
              : sessionWarnings.length > 0
                ? "登录已失鏁?
                : "鏈櫥褰?}
          </button>
          <button
            type="button"
            disabled={busy}
            onClick={() => void cloneRepo()}
            title="克隆到空文件澶?
          >
            克隆
          </button>
          <div className="sync-group" role="group" aria-label="鍚屾">
          <div
            className={`push-split fetch-split${fetchMenuOpen ? " is-open" : ""}`}
          >
          <button
            type="button"
            disabled={busy}
              title="鍙笅载远程更新，不改鏈湴文件"
            onClick={() => {
              setFetchMenuOpen(false);
              void runAction(
                () => api.fetch(repoPath, defaultRemoteName),
                defaultRemoteName
                  ? `正在获取 ${defaultRemoteName}鈥
                  : "正在获取鈥?,
              );
            }}
          >
              获取
          </button>
            {remotes.length > 0 && (
              <>
                <button
                  type="button"
                  className="push-caret"
                  disabled={busy}
                  title="选择获取的远绋?
                  aria-expanded={fetchMenuOpen}
                  onMouseDown={(event) => event.stopPropagation()}
                  onClick={(event) => {
                    event.stopPropagation();
                    setPushMenuOpen(false);
                    setPullMenuOpen(false);
                    setFetchMenuOpen((v) => !v);
                  }}
                >
                  鈻?                </button>
                {fetchMenuOpen && (
                  <div
                    className="push-menu"
                    role="menu"
                    onMouseDown={(event) => event.stopPropagation()}
                  >
                    {remotes.map((r) => (
                      <button
                        key={`fetch-${r.name}`}
                        type="button"
                        role="menuitem"
                        className={
                          defaultRemoteName === r.name ? "is-active" : undefined
                        }
                        disabled={busy}
                        onClick={() => {
                          setFetchMenuOpen(false);
                          void runAction(
                            () => api.fetch(repoPath, r.name),
                            `正在获取 ${r.name}鈥,
                          );
                        }}
                      >
                        <strong>{r.name}</strong>
                        <span className="muted small">{r.url}</span>
                      </button>
                    ))}
                    {remotes.length > 1 && (
                      <button
                        type="button"
                        role="menuitem"
                        disabled={busy}
                        onClick={() => {
                          setFetchMenuOpen(false);
                          void runAction(
                            () => api.fetch(repoPath, "all"),
                            "正在获取全部远程鈥?,
                          );
                        }}
                      >
                        <strong>全部远程</strong>
                        <span>fetch --all --prune</span>
                      </button>
                    )}
                  </div>
                )}
              </>
            )}
          </div>
          <div className={`push-split pull-split${pullMenuOpen ? " is-open" : ""}`}>
          <button
            type="button"
              className={behind > 0 ? "primary" : undefined}
            disabled={busy}
              title={
                pullMode === "rebase"
                  ? "变基拉取（Ctrl+Shift+L锛?
                  : "下载并合并到当前分支（Ctrl+Shift+L锛?
              }
            onClick={() => {
              setPullMenuOpen(false);
              void runAction(
                () => api.pull(repoPath, false, pullMode === "rebase"),
                pullMode === "rebase" ? "正在变基拉取鈥? : "正在拉取鈥?,
              );
            }}
          >
              {busy
                ? "鈥?
                : pullMode === "rebase"
                  ? behind > 0
                    ? `变基拉取 鈫?{behind}`
                    : "变基拉取"
                  : behind > 0
                    ? `拉取 鈫?{behind}`
                    : "拉取"}
          </button>
            <button
              type="button"
              className={`push-caret${behind > 0 ? " primary" : ""}`}
              disabled={busy}
              title="选择拉取方式"
              aria-expanded={pullMenuOpen}
              onMouseDown={(event) => event.stopPropagation()}
              onClick={(event) => {
                event.stopPropagation();
                setPushMenuOpen(false);
                setPullMenuOpen((v) => !v);
              }}
            >
              鈻?            </button>
            {pullMenuOpen && (
              <div
                className="push-menu"
                role="menu"
                onMouseDown={(event) => event.stopPropagation()}
              >
                <button
                  type="button"
                  role="menuitem"
                  className={pullMode === "merge" ? "is-active" : undefined}
                  disabled={busy}
                  onClick={() => {
                    setPullMode("merge");
                    setPullMenuOpen(false);
                  }}
                >
                  <strong>合并拉取</strong>
                  <span>下载后合并进当前分支</span>
                </button>
                <button
                  type="button"
                  role="menuitem"
                  className={pullMode === "rebase" ? "is-active" : undefined}
                  disabled={busy}
                  onClick={() => {
                    setPullMode("rebase");
                    setPullMenuOpen(false);
                  }}
                >
                  <strong>变基拉取</strong>
                  <span>把本地提交接到远程之鍚?/span>
                </button>
              </div>
            )}
          </div>
          <div className={`push-split${pushMenuOpen ? " is-open" : ""}`}>
          <button
            type="button"
              className={ahead > 0 && behind === 0 ? "primary" : undefined}
            disabled={busy}
              title={
                pushMode === "mirror" && mirrorButtonLabel
                  ? prefs.mirrorSyncMethod === "actions" &&
                    mirrorTarget === "gitee"
                    ? `${mirrorButtonLabel}：推閫?GitHub，由 Actions 鍚屾 Gitee（Ctrl+Shift+P）`
                    : `${mirrorButtonLabel}：本机先推默认远程再鍚屾（Ctrl+Shift+P）`
                  : "直接鎺ㄩ…佸埌榛樿远程（Ctrl+Shift+P锛?
              }
              onClick={() => {
                setPushMenuOpen(false);
                if (pushMode === "mirror" && mirrorTarget) {
                  void runMirrorPush();
                } else {
                  void runAction(
                    () => api.push(repoPath, false, null, activePushRemote),
                    activePushRemote && activePushRemote !== defaultRemoteName
                      ? `正在鎺ㄩ…佸埌 ${activePushRemote}鈥
                      : "正在鎺ㄩ…佲…?,
                  );
                }
              }}
            >
              {busy
                ? "鈥?
                : pushMode === "mirror" && mirrorButtonLabel
                  ? ahead > 0
                    ? `${mirrorButtonLabel} 鈫?{ahead}`
                    : mirrorButtonLabel
                  : ahead > 0
                    ? activePushRemote &&
                      activePushRemote !== defaultRemoteName
                      ? `鎺ㄩ…?${activePushRemote} 鈫?{ahead}`
                      : `鎺ㄩ…?鈫?{ahead}`
                    : activePushRemote &&
                        activePushRemote !== defaultRemoteName
                      ? `鎺ㄩ…?${activePushRemote}`
                      : "鎺ㄩ…?}
          </button>
            <button
              type="button"
              className={`push-caret${ahead > 0 && behind === 0 ? " primary" : ""}`}
              disabled={busy}
              title="选择鎺ㄩ…佹柟寮?
              aria-expanded={pushMenuOpen}
              onMouseDown={(event) => event.stopPropagation()}
              onClick={(event) => {
                event.stopPropagation();
                setPullMenuOpen(false);
                setPushMenuOpen((v) => !v);
              }}
            >
              鈻?            </button>
            {pushMenuOpen && (
              <div
                className="push-menu"
                role="menu"
                onMouseDown={(event) => event.stopPropagation()}
              >
                <button
                  type="button"
                  role="menuitem"
                  className={
                    pushMode === "direct" && !pushRemote ? "is-active" : undefined
                  }
                  disabled={busy}
                  onClick={() => {
                    setPushMode("direct");
                    setPushRemote(null);
                    setPushMenuOpen(false);
                  }}
                >
                  <strong>直接鎺ㄩ…?/strong>
                  <span>
                    {defaultRemoteName
                      ? `鎺ㄩ…佸埌榛樿远程锛?{defaultRemoteName}）`
                      : "鎺ㄩ…佸埌榛樿远程"}
                  </span>
                </button>
                {remotes.map((r) => (
                  <button
                    key={`push-remote-${r.name}`}
                    type="button"
                    role="menuitem"
                    className={
                      pushMode === "direct" && pushRemote === r.name
                        ? "is-active"
                        : undefined
                    }
                    disabled={busy}
                    onClick={() => {
                      setPushMode("direct");
                      setPushRemote(r.name);
                      setPushMenuOpen(false);
                    }}
                  >
                    <strong>鎺ㄩ…佸埌 {r.name}</strong>
                    <span className="muted small">{r.url}</span>
                  </button>
                ))}
                {mirrorMenuLabel && mirrorTarget && (
                  <button
                    type="button"
                    role="menuitem"
                    className={pushMode === "mirror" ? "is-active" : undefined}
                    disabled={busy}
                    onClick={() => {
                      setPushMode("mirror");
                      setPushMenuOpen(false);
                    }}
                  >
                    <strong>{mirrorMenuLabel}</strong>
                    <span>
                      {prefs.mirrorSyncMethod === "actions" &&
                      mirrorTarget === "gitee"
                        ? "鎺ㄩ…?GitHub，Actions 鑷姩镜像 Gitee"
                        : "鏈満先推榛樿远程，再鍚屾到另涓…平台"}
                    </span>
                  </button>
                )}
                <button
                  type="button"
                  role="menuitem"
                  className="is-danger"
                  disabled={busy}
                  onClick={() => {
                    setPushMenuOpen(false);
                    withConfirm(
                      "强制鎺ㄩ…佷細覆盖远程同名分支上的提交，确定继缁紵",
                      () => {
                        void runAction(
                          () =>
                            api.push(repoPath, true, null, activePushRemote),
                          "正在强制鎺ㄩ…佲…?,
                        );
                      },
                      { title: "强制鎺ㄩ…?, danger: true, confirmLabel: "强制鎺ㄩ…? },
                    );
                  }}
                >
                  <strong>强制鎺ㄩ…?/strong>
                  <span>
                    覆盖
                    {activePushRemote ? ` ${activePushRemote}` : "远程"}
                    锛?-force-with-lease锛?                  </span>
                </button>
              </div>
            )}
          </div>
          </div>
        </div>
      </header>

      {(busy || syncProgress) && (
        <div
          className={`sync-progress${syncProgress ? "" : " is-indeterminate"}`}
          role="status"
          aria-live="polite"
        >
          <div className="sync-progress-track">
            <div
              className="sync-progress-fill"
              style={
                syncProgress
                  ? { width: `${Math.max(2, syncProgress.percent)}%` }
                  : undefined
              }
            />
          </div>
          {syncProgress && (
            <div className="sync-progress-meta">
              <span>
                {syncProgress.label}
                {syncProgress.detail ? ` · ${syncProgress.detail}` : ""}
              </span>
              <span>{syncProgress.percent}%</span>
            </div>
          )}
        </div>
      )}

      {notice && (
        <button
          type="button"
          className={`notice-box status-dismiss${noticeSticky ? " is-sticky" : ""}`}
          title={noticeSticky ? `${notice}（点击关闂紝不会鑷姩消失）` : `${notice}（点击关闂級`}
          onClick={() => setNotice(null)}
        >
          {notice}
        </button>
      )}
      {error && (
        <div className="error-box error-banner-row">
          <button
            type="button"
            className="status-dismiss error-banner-text"
            title={`${error}（点击关闂級`}
            onClick={() => {
              setError(null);
              setAuthHint(false);
            }}
          >
            {error}
          </button>
          {authHint && (
            <button
              type="button"
              className="primary error-login-btn"
              onClick={() => openSettingsAuth()}
            >
              去登褰?            </button>
          )}
        </div>
      )}
      {sessionWarnings.length > 0 && !error && (
        <div className="hint-box auth-warn-strip">
          {sessionWarnings.join("銆?)} 登录已失鏁堛…?          <button type="button" className="linkish" onClick={() => openSettingsAuth()}>
            重新登录
          </button>
        </div>
      )}
      {updateInfo?.updateAvailable &&
        updateInfo.tagName !== dismissedUpdateTag && (
        <div className="update-banner" role="status">
          <div className="update-banner-text">
            发现新版鏈?<strong>v{updateInfo.latestVersion}</strong>
            （当鍓?v{updateInfo.currentVersion}锛?          </div>
          <div className="update-banner-actions">
            <button
              type="button"
              className="primary"
              disabled={updateBusy || busy}
              onClick={() => void downloadAndInstallUpdate()}
            >
              下载并安瑁?            </button>
            <button type="button" onClick={() => openSettings("about")} disabled={busy}>
              详情
            </button>
            <button
              type="button"
              className="linkish"
              onClick={() => setDismissedUpdateTag(updateInfo.tagName)}
            >
              稍后
            </button>
          </div>
        </div>
      )}
      {!identitySaved && (
        <div className="hint-box">
          提交鍓嶈先在
          <button type="button" className="linkish" onClick={() => openSettings("identity")}>
            设置
          </button>
          里填写名字和閭銆?        </div>
      )}
      {identitySaved && remotes.length === 0 && (
        <div className="hint-box">
          还没有远程地鍧…。可鍦ㄨ缃噷濉啓，或
          <button
            type="button"
            className="linkish"
            onClick={() => {
              const name =
                repoPath?.split(/[/\\]/).filter(Boolean).pop()?.trim() ||
                "repo";
              setPublishDraft({
                name,
                toGithub: Boolean(accounts?.github.loggedIn),
                toGitee: Boolean(accounts?.gitee.loggedIn),
                privateRepo: false,
              });
              setPublishDialog({ path: repoPath!, name });
            }}
          >
            创建远程仓库
          </button>
          （GitHub / Gitee锛夈…?        </div>
      )}
      {status?.operation === "merge" ||
      status?.operation === "cherry-pick" ||
      status?.operation === "rebase" ||
      status?.operation === "revert" ? (
        <div className="conflict-box">
          <div className="conflict-copy">
            <strong>
              {status.operation === "merge"
                ? "合并冲突"
                : status.operation === "rebase"
                  ? "变基冲突"
                  : status.operation === "revert"
                    ? "还原冲突"
                    : "鎷ｉ…夊啿绐?}
              {conflictFiles.length > 0
                ? ` · ${conflictFiles.length} 涓枃件`
                : " · 鍙户缁?}
            </strong>
            <span>
              {conflictFiles.length > 0
                ? "点文件打寮…宸紓，再鐢ㄣ…屾墦寮…冲突编辑鍣ㄣ…嶅理；暂存后点「继缁…嶃…?
                : "冲突已全部暂存，鍙互继续完成操作銆?}
            </span>
            {conflictFiles.length > 0 && (
              <div className="conflict-files">
                {conflictFiles.slice(0, 6).map((f) => (
                  <button
                    key={f.path}
                    type="button"
                    className="conflict-jump"
                    disabled={busy}
                    title={f.path}
                    onClick={() => {
                      setFileFilter("conflict");
                      setPane("diff");
                      setSelected({ path: f.path, staged: false });
                    }}
                  >
                    {f.path}
                  </button>
                ))}
                {conflictFiles.length > 6 ? (
                  <span className="muted small">绛?{conflictFiles.length} 涓?/span>
                ) : null}
              </div>
            )}
          </div>
          <span className="row-actions conflict-actions">
            {conflictFiles.length > 0 && (
              <button
                type="button"
                disabled={busy}
                onClick={() => {
                  setFileFilter("conflict");
                  setPane("diff");
                  const curIdx = conflictFiles.findIndex(
                    (f) => f.path === selected?.path,
                  );
                  const next =
                    conflictFiles[(curIdx + 1) % conflictFiles.length] ??
                    conflictFiles[0];
                  setSelected({ path: next.path, staged: false });
                }}
              >
                下一处冲绐?              </button>
            )}
            <button
              type="button"
              className="primary"
              disabled={busy || conflictFiles.length > 0}
              title={
                conflictFiles.length > 0
                  ? "还有鏈В决冲突，暂存全部冲突文件后可继续"
                  : undefined
              }
              onClick={() =>
                void runAction(
                  () => api.continueOperation(repoPath),
                  status.operation === "merge"
                    ? "正在完成合并鈥?
                    : status.operation === "rebase"
                      ? "正在继续变基鈥?
                      : status.operation === "revert"
                        ? "正在完成还原鈥?
                        : "正在完成鎷ｉ…夆…?,
                )
              }
            >
              继续
            </button>
            {status.operation === "rebase" && (
              <button
                type="button"
                disabled={busy}
                title="跳过当前正在应用的提交，继续变基后续提交"
                onClick={() =>
                  withConfirm(
                    "跳过当前变基提交锛熻提交不会应用到当前分鏀…?,
                    () => {
                      void runAction(
                        () => api.skipRebase(repoPath),
                        "正在跳过变基提交鈥?,
                      );
                    },
                    { title: "跳过提交", danger: true, confirmLabel: "跳过" },
                  )
                }
              >
                跳过
              </button>
            )}
            <button
              type="button"
              className="danger"
              disabled={busy}
              onClick={() => {
                const label =
                  status.operation === "merge"
                    ? "放弃杩欐合并锛?
                    : status.operation === "rebase"
                      ? "放弃杩欐变基锛?
                      : status.operation === "revert"
                        ? "放弃杩欐还原锛?
                        : "放弃杩欐鎷ｉ…夛紵";
                withConfirm(label, () => {
                  void runAction(
                    () => api.abortOperation(repoPath),
                    status.operation === "merge"
                      ? "正在放弃合并鈥?
                      : status.operation === "rebase"
                        ? "正在放弃变基鈥?
                        : status.operation === "revert"
                          ? "正在放弃还原鈥?
                          : "正在放弃鎷ｉ…夆…?,
                  );
                });
              }}
            >
              放弃
            </button>
          </span>
        </div>
      ) : null}
      {showSettings && renderSettings()}
      {showHelp && renderHelp()}
      {showAbout && renderAbout()}
      {renderPublishDialog()}
      {renderSyncDialog()}
      {renderResetDialog()}
      {renderRenameDialog()}
      {renderCheckoutDialog()}
      {renderCloneDialog()}
      {renderUpstreamDialog()}
      {renderLargeCommitDialog()}
      {renderRebaseInteractiveDialog()}

      {openRepos.length > 0 && (
        <div className="repo-tabs" role="tablist" aria-label="已打寮…仓库">
          {openRepos.map((path) => (
            <div
              key={path}
              className={`repo-tab ${path === repoPath ? "active" : ""}`}
              role="tab"
              aria-selected={path === repoPath}
            >
              <button
                type="button"
                className="repo-tab-open"
                disabled={busy}
                title={path}
                onClick={() => {
                  if (path !== repoPath) void openFolder(path);
                }}
              >
                {folderName(path)}
              </button>
              <button
                type="button"
                className="repo-tab-close"
                disabled={busy}
                title="关闭鏍囩"
                aria-label={`关闭 ${folderName(path)}`}
                onClick={() => closeRepoTab(path)}
              >
                ×
              </button>
            </div>
          ))}
        </div>
      )}

      <div className="main">
        <aside className="sidebar">
          <div className="changes-filter">
            <input
              value={fileQuery}
              onChange={(e) => setFileQuery(e.target.value)}
              placeholder="绛涢…夋枃件路寰勨…?
              aria-label="绛涢…夋枃件路寰?
            />
            <div className="filter-chips" role="group" aria-label="改动绛涢…?>
              {(
                [
                  ["all", "全部"],
                  ["conflict", "冲突"],
                  ["untracked", "鏈窡韪?],
                ] as const
              ).map(([id, label]) => (
                <button
                  key={id}
                  type="button"
                  className={fileFilter === id ? "active" : undefined}
                  onClick={() => setFileFilter(id)}
                >
                  {label}
                  {id === "conflict" && conflictFiles.length > 0
                    ? ` ${conflictFiles.length}`
                    : ""}
                </button>
              ))}
            </div>
          </div>
          <div className="sidebar-scroll">
          <ChangeList
            title="已暂瀛?
            sectionId="staged"
            stickyTop="0"
            files={filteredStaged}
            selected={selected && selected.staged ? selected.path : null}
            stagedSection
            busy={busy}
            onSelect={(path) => setSelected({ path, staged: true })}
            onUnstage={(paths) => runAction(() => api.unstageFiles(repoPath, paths))}
            onFileHistory={(path) => void loadFileHistory(path)}
          />
          <ChangeList
            title="鏈殏瀛?
            sectionId="unstaged"
            stickyTop="0"
            files={filteredUnstaged}
            selected={selected && !selected.staged ? selected.path : null}
            stagedSection={false}
            busy={busy}
            onSelect={(path) => setSelected({ path, staged: false })}
            onStage={(paths) => runAction(() => api.stageFiles(repoPath, paths))}
            onDiscard={(paths) => runAction(() => api.discardFiles(repoPath, paths))}
            onIgnore={(paths) =>
              void runAction(
                () => api.addGitignore(repoPath, paths),
                "正在写入 .gitignore鈥?,
              )
            }
            onFileHistory={(path) => void loadFileHistory(path)}
          />

          <div className="panel branch-panel">
            <div className="panel-header">
              <strong>分支</strong>
            </div>
            <ul className="branch-list">
              {branches.map((b) => (
                <li key={b.name} className={b.isCurrent ? "current" : ""}>
                  <button
                    type="button"
                    disabled={busy || b.isCurrent}
                    onClick={() =>
                      runAction(() => api.branchCheckout(repoPath, b.name))
                    }
                  >
                    {b.isCurrent ? "鈼?" : "鈼?"}
                    {b.name}
                    {b.upstream ? (
                      <span className="muted small"> 鈫?{b.upstream}</span>
                    ) : null}
                  </button>
                  <span className="row-actions">
                    <button
                      type="button"
                      disabled={busy}
                      title="重命名分鏀?
                      onClick={() =>
                        setRenameTarget({ oldName: b.name, value: b.name })
                      }
                    >
                      重命鍚?                    </button>
                    {remotes.length > 0 && (
                      <button
                        type="button"
                        disabled={busy}
                        title={
                          b.upstream
                            ? `当前上游锛?{b.upstream}（点击更改）`
                            : "设置上游跟踪分支"
                        }
                        onClick={() => {
                          const remote =
                            (b.upstream?.includes("/")
                              ? b.upstream.split("/")[0]
                              : null) ||
                            defaultRemoteName ||
                            remotes[0]!.name;
                          const remoteBranch =
                            (b.upstream?.includes("/")
                              ? b.upstream.slice(b.upstream.indexOf("/") + 1)
                              : null) || b.name;
                          setUpstreamTarget({
                            localBranch: b.name,
                            remote,
                            remoteBranch,
                          });
                        }}
                      >
                        {b.upstream ? "改上娓? : "设上娓?}
                      </button>
                    )}
                    {!b.isCurrent && (
                      <button
                        type="button"
                        className="danger"
                        disabled={busy}
                        onClick={() =>
                          withConfirm(`删除鏈湴分支銆?{b.name}」？`, () => {
                            void runAction(async () => {
                              try {
                                return await api.branchDelete(
                                  repoPath,
                                  b.name,
                                  false,
                                );
                              } catch (e) {
                                const raw = String(e);
                                if (
                                  raw.includes("BRANCH_NOT_MERGED:") ||
                                  /not fully merged/i.test(raw)
                                ) {
                                  const force = await confirmAction(
                                    `分支銆?{b.name}」尚鏈畬全合并到当前分支。强制删除？鏈悎并的提交鍙兘丢失。`,
                                    {
                                      title: "强制删除分支",
                                      danger: true,
                                      confirmLabel: "强制删除",
                                    },
                                  );
                                  if (!force) return "已取消删闄?;
                                  return api.branchDelete(repoPath, b.name, true);
                                }
                                throw e;
                              }
                            }, "正在删除分支鈥?);
                          })
                        }
                      >
                        删除
                      </button>
                    )}
                  </span>
                </li>
              ))}
            </ul>
            <div className="new-branch">
              <input
                value={newBranch}
                onChange={(e) => setNewBranch(e.target.value)}
                placeholder="新分鏀悕"
              />
              <button
                type="button"
                disabled={busy || !newBranch.trim()}
                onClick={() =>
                  runAction(async () => {
                    await api.branchCreate(repoPath, newBranch.trim());
                    setNewBranch("");
                  })
                }
              >
                新建
              </button>
              <button
                type="button"
                className="danger"
                disabled={busy}
                title="清理鏈窡韪枃件（鍏堥览）"
                onClick={() => {
                  void runAction(async () => {
                    const preview = await api.cleanFiles(repoPath, true, false);
                    const ok = await confirmAction(
                      preview.trim()
                        ? `将删除以下未跟踪文件：\n\n${preview}\n纭畾清理？`
                        : "没有鍙竻理的鏈窡韪枃浠躲…?,
                      {
                        title: "清理鏈窡韪枃浠?,
                        danger: true,
                        confirmLabel: "清理",
                      },
                    );
                    if (!ok || !preview.trim() || preview.includes("没有鍙竻鐞?)) {
                      return preview.includes("没有鍙竻鐞?)
                        ? preview
                        : "已取消清鐞?;
                    }
                    return api.cleanFiles(repoPath, false, false);
                  }, "正在清理鈥?);
                }}
              >
                清理
              </button>
            </div>
            <div className="new-branch">
              <select
                value={mergeTarget}
                onChange={(e) => setMergeTarget(e.target.value)}
                disabled={busy}
              >
                <option value="">合并其他分支到当鍓嶁…?/option>
                {branches
                  .filter((b) => !b.isCurrent)
                  .map((b) => (
                    <option key={b.name} value={b.name}>
                      {b.name}
                    </option>
                  ))}
              </select>
              <button
                type="button"
                disabled={busy || !mergeTarget}
                onClick={() =>
                  withConfirm(`鎶娿…?{mergeTarget}」合并进当前分支？`, () => {
                    void runAction(
                      () => api.branchMerge(repoPath, mergeTarget),
                      "正在合并鈥?,
                    );
                  })
                  }
              >
                合并
              </button>
            </div>
            <div className="new-branch">
              <select
                value={rebaseTarget}
                onChange={(e) => setRebaseTarget(e.target.value)}
                disabled={busy}
              >
                <option value="">把当前分鏀彉基到鈥?/option>
                {branches
                  .filter((b) => !b.isCurrent)
                  .map((b) => (
                    <option key={`rebase-${b.name}`} value={b.name}>
                      {b.name}
                    </option>
                  ))}
              </select>
              <button
                type="button"
                disabled={busy || !rebaseTarget}
                title="把当前分鏀殑提交接到鎵…选分鏀渶新提交之鍚?
                onClick={() =>
                  withConfirm(
                    `把当前分鏀彉基到銆?{rebaseTarget}」？\n历史鍙兘琚敼写；若已鎺ㄩ…侊紝之后鍙兘闇…要强制推閫併…俙,
                    () => {
                      void runAction(
                        () => api.branchRebase(repoPath, rebaseTarget),
                        "正在变基鈥?,
                      );
                    },
                  )
                }
              >
                变基
              </button>
              <button
                type="button"
                disabled={busy || !rebaseTarget}
                title="调整提交顺序，并鍙?squash / fixup / drop"
                onClick={() => {
                  void runAction(async () => {
                    const commits = await api.getRebaseTodo(
                      repoPath,
                      rebaseTarget,
                    );
                    if (commits.length === 0) {
                      throw new Error(
                        `鐩稿銆?{rebaseTarget}」没有可回放的提浜,
                      );
                    }
                    setRebaseInteractive({
                      onto: rebaseTarget,
                      rows: commitsToRebaseRows(commits),
                    });
                    return `已加杞?${commits.length} 涓彁浜;
                  }, "正在鍑嗗交互变基鈥?);
                }}
              >
                交互变基
              </button>
            </div>
            <div className="panel-header remote-branch-header">
              <strong>远程分支</strong>
              <span className="muted small">
                {remoteBranches.length === 0
                  ? "先点「获鍙栥…嶄笅载远程分鏀垪琛?
                  : "妫…出可创建/切换鏈湴跟踪分支"}
              </span>
            </div>
            {remoteBranches.length === 0 ? (
              <p className="muted small pad">暂无远程分支记录</p>
            ) : (
              <ul className="branch-list remote-branch-list">
                {remoteBranches.map((rb) => (
                  <li key={rb.name}>
                    <span className="remote-branch-name">
                      {rb.name}
                      <span className="muted small"> {rb.tip}</span>
                      {rb.hasLocal ? (
                        <span className="muted small"> · 已有鏈湴</span>
                      ) : null}
                    </span>
                    <span className="row-actions">
                      <button
                        type="button"
                        disabled={busy}
                        onClick={() =>
                          void runAction(
                            () => api.remoteBranchCheckout(repoPath, rb.name),
                            "正在妫…出远程分鏀…?,
                          )
                        }
                      >
                        妫…鍑?                      </button>
                      <button
                        type="button"
                        className="danger"
                        disabled={busy}
                        onClick={() =>
                          withConfirm(
                            `删除远程分支銆?{rb.name}」？\n这会浠?GitHub/Gitee 上删鎺夎分支，本地同名分鏀粛保留。`,
                            () => {
                              void runAction(
                                () => api.remoteBranchDelete(repoPath, rb.name),
                                "正在删除远程分支鈥?,
                              );
                            },
                          )
                        }
                      >
                        删除
                      </button>
                    </span>
                  </li>
                ))}
              </ul>
            )}
          </div>
          </div>

          <div className="panel commit-panel">
            <div className="panel-header">
              <strong>提交</strong>
              {identitySaved ? (
                <button
                  type="button"
                  className="linkish muted small"
                  onClick={() => openSettings("identity")}
                >
                  {identity.name} · {identity.email}
                </button>
              ) : (
                <button
                  type="button"
                  className="linkish muted small"
                  onClick={() => openSettings("identity")}
                >
                  鍘昏缃噷濉啓名字和邮绠?                </button>
              )}
            </div>
            <textarea
              value={message}
              onChange={(e) => setMessage(e.target.value)}
              placeholder="提交说明"
              rows={3}
            />
            <div className="commit-actions">
              <button
                type="button"
                className="primary"
                disabled={
                  busy ||
                  !message.trim() ||
                  staged.length === 0 ||
                  !identitySaved
                }
                title="提交（Ctrl+Enter）；超过 100MB 的文件会先提绀?
                onClick={() => void requestCommit("commit")}
              >
                提交 {staged.length > 0 ? `(${staged.length})` : ""}
              </button>
              <button
                type="button"
                disabled={busy || !identitySaved || commits.length === 0}
                title="淇敼鏈…近一次未鎺ㄩ…佺殑提交"
                onClick={() =>
                  withConfirm(
                      message.trim()
                        ? "用当鍓嶈明修改最近一次提交？"
                        : "保留鍘熻明，把已暂存改动并入鏈…近一次提交？",
                    () => {
                      void requestCommit("amend");
                    },
                  )
                }
              >
                淇敼涓婃
              </button>
              <button
                type="button"
                disabled={busy || commits.length === 0}
                title="撤销鏈…近一次未鎺ㄩ…佺殑提交，改动回到暂存区"
                onClick={() =>
                  withConfirm(
                    "撤销鏈…近一次提交？说明会去掉，文件改动仍留在暂存区。已鎺ㄩ…佺殑提交不能撤销銆?,
                    () => {
                      void runAction(
                        () => api.undoCommit(repoPath),
                        "正在撤销涓婃提交鈥?,
                      );
                    },
                  )
                }
              >
                撤销涓婃
              </button>
            </div>
          </div>
        </aside>

        <ExtraPane
          pane={pane}
          onPane={setPane}
          diffPath={selected?.path ?? null}
          diffStaged={selected?.staged ?? false}
          diffText={diff}
          diffLoading={diffLoading}
          hasChanges={hasChanges}
          allowHunks={
            Boolean(selected) &&
            !status?.changes.find((c) => c.path === selected?.path)?.untracked
          }
          onApplyHunk={(patch, reverse) =>
            runAction(
              () => api.applyPatch(repoPath, patch, reverse),
              reverse ? "正在取消暂存此块鈥? : "正在暂存此块鈥?,
            )
          }
          onDiscardHunk={async (patch) => {
            const ok = await confirmAction(
              "放弃工作区中这一块改鍔紵不可鎭㈠銆?,
              { title: "放弃此块", danger: true, confirmLabel: "放弃" },
            );
            if (!ok) return false;
            return runAction(
              () => api.applyWorkdirHunk(repoPath, patch, true),
              "正在放弃此块鈥?,
            );
          }}
          onBlame={
            selected
              ? () => {
                  void runAction(async () => {
                    const text = await api.getFileBlame(
                      repoPath,
                      selected.path,
                    );
                    setBlameText(text);
                    setPane("diff");
                    return "已加载文件追婧?;
                  }, "正在追溯鈥?);
                }
              : undefined
          }
          blameText={blameText}
          onClearBlame={() => setBlameText(null)}
          fileConflicted={Boolean(
            selected &&
              status?.changes.find((c) => c.path === selected.path)?.conflicted,
          )}
          conflictContent={conflictContent}
          conflictLoading={conflictLoading}
          onOpenConflict={
            selected
              ? () => {
                  void (async () => {
                    setConflictLoading(true);
                    setBlameText(null);
                    setPane("diff");
                    try {
                      const text = await api.readRepoFile(
                        repoPath,
                        selected.path,
                      );
                      setConflictContent(text);
                    } catch (e) {
                      setConflictContent(null);
                      setError(failureLine(e));
                    } finally {
                      setConflictLoading(false);
                    }
                  })();
                }
              : undefined
          }
          onCloseConflict={() => setConflictContent(null)}
          onSaveConflict={(content, stage) => {
            if (!selected) return;
            void runAction(async () => {
              await api.writeRepoFile(repoPath, selected.path, content);
              if (stage) {
                await api.stageFiles(repoPath, [selected.path]);
              }
              setConflictContent(null);
              const stillConflicted = (
                await api.getStatusLight(repoPath)
              ).changes.some(
                (c) => c.path === selected.path && c.conflicted,
              );
              if (stage && stillConflicted) {
                return "已写入，浣?Git 仍将该文件标为冲突，请确认标记已全部去掉后再暂存";
              }
              return stage ? "已保存并暂存冲突文件" : "已保存冲突文浠?;
            }, stage ? "正在保存并暂瀛樷…? : "正在保存鈥?);
          }}
          showReflog={showReflog}
          reflogEntries={reflogEntries}
          onToggleReflog={() => {
            if (showReflog) {
              setShowReflog(false);
              return;
            }
            void runAction(async () => {
              const entries = await api.getReflog(repoPath);
              setReflogEntries(entries);
              setShowReflog(true);
              setPane("history");
              return "已加载操浣滆褰?;
            }, "正在加载操作记录鈥?);
          }}
          onSelectReflog={(entry) => {
            setSelectedHash(entry.hash);
            setShowReflog(false);
          }}
          showCommitGraph={prefs.showCommitGraph}
          commits={fileHistoryCommits ?? commits}
          historyScope={fileHistoryPath}
          onClearHistoryScope={() => {
            setFileHistoryPath(null);
            setFileHistoryCommits(null);
          }}
          selectedHash={selectedHash}
          commitPatch={commitPatch}
          patchLoading={patchLoading}
          onSelectCommit={setSelectedHash}
          onCherryPick={(hash) => {
            withConfirm(`把提浜?${hash.slice(0, 7)} 鎷ｉ…夊埌当前分支？`, () => {
              void runAction(() => api.cherryPick(repoPath, hash), "正在鎷ｉ…夆…?);
            });
          }}
          onRevert={(hash) => {
            withConfirm(
              `还原提交 ${hash.slice(0, 7)}？会生成涓…涓弽向提浜ゃ…俙,
              () => {
                void runAction(
                  () => api.revertCommit(repoPath, hash),
                  "正在还原鈥?,
                );
              },
            );
          }}
          onCheckoutCommit={(commit) =>
            setCheckoutTarget({ commit, branchName: "" })
          }
          onResetCommit={(commit) => setResetTarget(commit)}
          stashes={stashes}
          stashMessage={stashMessage}
          onStashMessage={setStashMessage}
          stashIncludeUntracked={stashIncludeUntracked}
          onStashIncludeUntracked={setStashIncludeUntracked}
          onStash={() =>
            runAction(async () => {
              await api.createStash(
                repoPath,
                stashMessage,
                stashIncludeUntracked,
              );
              setStashMessage("");
            })
          }
          onPopStash={(index) => runAction(() => api.popStash(repoPath, index))}
          onApplyStash={(index) =>
            runAction(() => api.applyStash(repoPath, index), "正在应用储藏鈥?)
          }
          onShowStash={(index) => {
            void runAction(async () => {
              const text = await api.showStash(repoPath, index);
              setStashPreview(text);
              setPane("stash");
              return "已加载储藏内瀹?;
            }, "正在查看储藏鈥?);
          }}
          onDropStash={(index) => {
            withConfirm(`丢弃 stash@{${index}}？`, () => {
              void runAction(() => api.dropStash(repoPath, index));
            });
          }}
          stashPreview={stashPreview}
          onClearStashPreview={() => setStashPreview(null)}
          tags={tags}
          tagName={tagName}
          onTagName={setTagName}
          tagMessage={tagMessage}
          onTagMessage={setTagMessage}
          onCreateTag={() =>
            runAction(async () => {
              await api.tagCreate(
                repoPath,
                tagName.trim(),
                tagMessage.trim() || null,
              );
              setTagName("");
              setTagMessage("");
            })
          }
          compareLeft={compareLeft}
          compareRight={compareRight}
          onCompareLeft={setCompareLeft}
          onCompareRight={setCompareRight}
          onCompare={() => {
            void runAction(async () => {
              const text = await api.compareRefs(
                repoPath,
                compareLeft.trim(),
                compareRight.trim(),
              );
              setCompareResult(text);
              return "比较完成";
            }, "正在比较鈥?);
          }}
          compareResult={compareResult}
          onPushTag={(name) =>
            void runAction(() => api.tagPush(repoPath, name), "正在鎺ㄩ…佹爣绛锯…?)
          }
          onPushAllTags={() => {
            withConfirm("把全部本地标签推送到远程锛?, () => {
              void runAction(() => api.tagPushAll(repoPath), "正在鎺ㄩ…佸叏部标绛锯…?);
            });
          }}
          onDeleteTag={(name) => {
            withConfirm(`删除鏈湴鏍囩銆?{name}」？`, () => {
              void runAction(() => api.tagDelete(repoPath, name), "正在删除鏍囩鈥?);
            });
          }}
          onDeleteRemoteTag={(name) => {
            withConfirm(
              `删除远程鏍囩銆?{name}」？\n会从 GitHub/Gitee 上移闄よ鏍囩，本地标签仍保留。`,
              () => {
                void runAction(
                  () => api.tagDeleteRemote(repoPath, name),
                  "正在删除远程鏍囩鈥?,
                );
              },
            );
          }}
          terminalText={terminal}
          onClearTerminal={() => setTerminal("")}
          terminalWallpaperUrl={terminalWallpaperUrl}
          terminalWallpaperKind={prefs.terminalWallpaperKind}
          terminalWallpaperScrim={prefs.terminalWallpaperScrim}
          releaseOwner={releaseTarget.owner}
          releaseRepo={releaseTarget.repo}
          releaseDefaultTag=""
          githubLoggedIn={Boolean(accounts?.github.loggedIn)}
          updateBusy={updateBusy}
          onUpdateBusy={setUpdateBusy}
          onNotice={setNotice}
          onError={setError}
          onOpenAuth={() => openSettingsAuth("github")}
          onConfigureReleaseRepo={() => openSettings("appearance")}
          updateProgress={updateProgress}
          onRunCommand={(line) => {
            if (busyRef.current) return;
            setTerminal((prev) => `${prev}$ ${line}\n`);
            busyRef.current = true;
            setBusy(true);
            setNotice("正在鎵ц命令鈥?);
            setError(null);
            void api
              .runCommand(repoPath, line)
              .then(async (output) => {
                if (output.trim()) {
                  setTerminal((prev) => `${prev}${output.trimEnd()}\n`);
                }
                setNotice("命令已执琛?);
                await refresh(repoPath);
              })
              .catch((e) => {
                const message = String(e);
                setTerminal((prev) => `${prev}${message}\n`);
                setNotice(null);
                setError(failureLine(e));
                busyRef.current = false;
                setBusy(false);
              });
          }}
          busy={busy}
        />
      </div>
    </div>
    </>
  );
}
